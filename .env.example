# Used by the Prisma CLI (prisma.config.ts) for schema/migration commands
# run from the repo root, e.g. `npm run prisma:generate`.
# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/comet_autos_dev?schema=public"


DIRECT_URL=XXXXX
AUTH_SECRET=XXXXX
NEXTAUTH_URL=XXXXX
CLOUDINARY_CLOUD_NAME=XXXXX
CLOUDINARY_API_KEY=XXXXX
CLOUDINARY_API_SECRET=XXXXX
# Photo/signature storage: "local" (./.local-storage) or "cloudinary".
# Defaults to cloudinary when CLOUDINARY_CLOUD_NAME is set, otherwise local.
# STORAGE_DRIVER=local
