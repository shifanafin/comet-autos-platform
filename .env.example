# Copy this file to .env and fill in real values. Never commit .env.
# The same variables go into the hosting dashboard (e.g. Vercel → Settings →
# Environment Variables) for the deployed app.

# Hosted PostgreSQL (Supabase). The app uses the pooled connection; the
# Prisma CLI (migrations) uses the direct one — see prisma.config.ts.
DATABASE_URL="postgresql://postgres.<project>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project>:<password>@<region>.pooler.supabase.com:5432/postgres"

AUTH_SECRET=XXXXX
NEXTAUTH_URL=https://your-domain.example

# Photo and signature storage (Cloudinary).
CLOUDINARY_CLOUD_NAME=XXXXX
CLOUDINARY_API_KEY=XXXXX
CLOUDINARY_API_SECRET=XXXXX
# Uses Cloudinary whenever CLOUDINARY_CLOUD_NAME is set. STORAGE_DRIVER=local
# keeps files in ./.local-storage instead (never committed).
# STORAGE_DRIVER=local

