enum AssignmentRole {
  PRIMARY
  SUPPORT
}

/// V1 customer secure-access resources (section 13-15 of the V1 build
/// instruction): a CustomerAccessToken always grants access to exactly one
/// resource of one of these types, never a general customer login.
enum CustomerAccessResourceType {
  ESTIMATE
  INVOICE
}

enum InspectionStatus {
  IN_PROGRESS
  COMPLETED
}

enum InspectionItemResult {
  OK
  ATTENTION_NEEDED
  FAILED
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  EXPIRED
}

/// ORIGINAL: the quotation for the job (with its revision chain).
/// ADDITIONAL: extra work found during repair, quoted and approved separately
/// so it is never silently added to what the customer already approved.
enum EstimateKind {
  ORIGINAL
  ADDITIONAL
}

enum QualityCheckStatus {
  PASSED
  FAILED
}

enum EstimateItemType {
  PART
  LABOUR
  OTHER
}

/// How a discount was entered: a percentage of the amount, or a fixed AED amount.
enum DiscountType {
  PERCENT
  AMOUNT
}

/// How a line is treated for UAE VAT. STANDARD is charged at the workshop's
/// VAT rate (5%); ZERO_RATED at 0% but still a taxable supply (VAT201 Box 4);
/// EXEMPT is not taxable (Box 5); OUT_OF_SCOPE is not a supply for VAT at all
/// (e.g. a fine passed on at cost) and is left out of the return.
enum VatTreatment {
  STANDARD
  ZERO_RATED
  EXEMPT
  OUT_OF_SCOPE
}

/// The emirate a workshop's supplies are made in — VAT201 splits Box 1 by it.
enum Emirate {
  ABU_DHABI
  DUBAI
  SHARJAH
  AJMAN
  UMM_AL_QUWAIN
  RAS_AL_KHAIMAH
  FUJAIRAH
}

enum CreditNoteStatus {
  ISSUED
  VOID
}

enum ReconciliationStatus {
  IN_PROGRESS
  COMPLETED
}

/// How a fixed asset was paid for, which decides what its purchase is
/// booked against.
enum AssetFunding {
  /// Paid from a cash or bank account.
  PAID
  /// Bought on credit: owed to the supplier.
  ON_CREDIT
  /// Owned before the books began: brought in against opening balance equity.
  OPENING
}

enum FixedAssetStatus {
  ACTIVE
  DISPOSED
}

/// What a system account is for. Automatic postings find their accounts by
/// role, so a workshop can rename or renumber them freely. One account per
/// role per workshop (see lib/accounting/chart.ts).
/// Who an account's sub-ledger is kept by.
enum PartyType {
  CUSTOMER
  SUPPLIER
}

enum AccountRole {
  CASH
  BANK
  CARD_CLEARING
  ACCOUNTS_RECEIVABLE
  INVENTORY
  VAT_INPUT
  ACCOUNTS_PAYABLE
  VAT_OUTPUT
  OPENING_BALANCE
  RETAINED_EARNINGS
  SALES_PARTS
  SALES_LABOUR
  SALES_OTHER
  SALES_DISCOUNTS
  COST_OF_PARTS
  STOCK_ADJUSTMENTS
  OTHER_EXPENSES
  SALARIES_EXPENSE
  SALARIES_PAYABLE
  VAT_SETTLEMENT
  ASSET_DISPOSALS
  /// "Due to owner (current account)": what the business owes an owner or
  /// partner who paid a business cost with their own money.
  OWNER_ADVANCES
  /// "Customer advances": money a customer paid before their invoice,
  /// owed to them in work (or back) until applied to an invoice.
  CUSTOMER_ADVANCES
  /// "Rounding adjustments": the round-off on an invoice (e.g. −0.50 to
  /// make 3,654.50 into 3,654.00). Outside VAT.
  ROUNDING
  /// "Owner's capital": money an owner put into the business to stay in it.
  OWNER_CAPITAL
  /// "Owner's drawings": money an owner took out of the business for themselves.
  OWNER_DRAWINGS
  /// Input VAT on parts received before the supplier's tax invoice: held
  /// here, and moved to VAT_INPUT once the bill is matched.
  VAT_INPUT_PENDING
  /// "End-of-service benefits expense": each month's increase in what the
  /// team would be owed in gratuity, booked with the payroll.
  GRATUITY_EXPENSE
  /// "Provision for end-of-service benefits": the gratuity the team has
  /// earned so far, owed when each person leaves.
  GRATUITY_PROVISION
  /// "Bank charges": what the bank keeps — the card machine's fee on a
  /// settlement — and the fee recovered from someone it was really for.
  BANK_CHARGES
  /// "Money collected for others": card payments taken on the workshop's
  /// machine for someone else (an outside upholsterer…), owed to them until
  /// paid over on a payment voucher.
  MONEY_HELD_FOR_OTHERS
}

/// The kind of record a journal entry books.
enum JournalSource {
  INVOICE
  PAYMENT
  EXPENSE
  STOCK_MOVEMENT
  SUPPLIER_PAYMENT
  /// A payroll run approved: the salaries it owes.
  PAYROLL
  /// A payroll run paid out.
  PAYROLL_PAYMENT
  /// A VAT return filed: the period's VAT moved to what is due to the FTA.
  VAT_FILING
  /// VAT paid to the FTA, or a refund received from it.
  VAT_PAYMENT
  /// A tax credit note issued against an invoice.
  CREDIT_NOTE
  /// Money paid back to a customer under a credit note.
  CREDIT_NOTE_REFUND
  /// A fixed asset bought (or brought in at opening).
  FIXED_ASSET
  /// A month's depreciation of a fixed asset.
  DEPRECIATION
  /// A fixed asset sold or scrapped.
  ASSET_DISPOSAL
  /// The balances brought in when the books began (accounts, and each
  /// customer's opening balance invoice).
  OPENING_BALANCE
  /// A financial year closed: income and expenses moved to retained
  /// earnings. Left out of every profit and loss.
  YEAR_END_CLOSE
  MANUAL
  /// An owner repaid for business costs they paid personally.
  OWNER_REIMBURSEMENT
  /// Money moved between the workshop's own cash, bank and card accounts.
  MONEY_TRANSFER
  /// Money a customer paid in advance, before any invoice.
  CUSTOMER_ADVANCE
  /// Part of a customer advance applied to an invoice.
  CUSTOMER_ADVANCE_ALLOCATION
  /// Part of a customer advance paid back to the customer.
  CUSTOMER_ADVANCE_REFUND
  /// A discount given after an invoice, off its total (VAT unchanged).
  INVOICE_DISCOUNT
  /// A purchase's round-off, once the whole purchase is received.
  PURCHASE_ROUNDING
  /// An owner putting money into the business, or taking it out.
  OWNER_MONEY
  /// The supplier's tax invoice arrived after the parts: the input VAT moves
  /// from "awaiting tax invoice" to recoverable, on the bill's date.
  PURCHASE_BILL
  /// Card money taken on the workshop's machine for someone else: owed to them.
  CARD_COLLECTION
  /// A payment voucher paying that money over, less the bank's fee.
  PAYMENT_VOUCHER
  /// One month's totals from before these books began (PriorPeriodSummary).
  PRIOR_PERIOD
}

enum ApprovalStatus {
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
}

/// How the customer's decision reached the workshop.
/// ONLINE: the customer decided themselves on the secure quotation link
/// (no staff member records it). IN_PERSON / PHONE / EMAIL / SMS: the
/// customer told a staff member, who recorded it. DIGITAL_SIGNATURE is
/// reserved for a captured signature (not built yet).
enum ApprovalMethod {
  IN_PERSON
  PHONE
  EMAIL
  SMS
  DIGITAL_SIGNATURE
  ONLINE
}

enum ApprovalItemDecision {
  APPROVED
  REJECTED
}

/// Workshop job lifecycle. Forward path:
///   ARRIVED → INSPECTION → DIAGNOSIS → ESTIMATE → WAITING_APPROVAL
///   → APPROVED | REJECTED → REPAIR → QUALITY_CHECK → READY → INVOICED
///   → PAID → DELIVERED
/// Exceptions: ON_HOLD (resumes where it paused), CANCELLED (terminal).
///
/// LEGACY values (RECEIVED, INSPECTING, DIAGNOSED, ESTIMATE_SENT,
/// IN_PROGRESS, COMPLETED, CLOSED) are the original coarse V1 states. They
/// are no longer written by the application and live job cards were
/// migrated off them (migration 20260918…_job_status_data). They remain in
/// the enum only because JobStatusHistory is append-only and still records
/// transitions that happened under the old names; PostgreSQL cannot drop
/// enum values without rewriting that history.
enum JobCardStatus {
  RECEIVED
  INSPECTING
  DIAGNOSED
  ESTIMATE_SENT
  APPROVED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  INVOICED
  CLOSED
  CANCELLED
  ARRIVED
  INSPECTION
  DIAGNOSIS
  ESTIMATE
  WAITING_APPROVAL
  REJECTED
  REPAIR
  QUALITY_CHECK
  READY
  PAID
  DELIVERED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// REVERSED (post-receipt correction, requires a reversing journal entry) is
/// distinct from CANCELLED (pre-receipt abandonment, no financial impact).
enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  REVERSED
}

enum InventoryTransactionType {
  PURCHASE_RECEIPT
  JOB_CONSUMPTION
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN_TO_SUPPLIER
  /// A part a customer brought back, credited on a credit note
  /// (creditNoteId). Its cost comes off cost of sales on the credit note.
  CUSTOMER_RETURN
  /// First stock of a part at a branch. (Rows written before this value
  /// existed are ADJUSTMENTs noted "Opening stock" — history is not rewritten.)
  OPENING_STOCK
  /// A part taken back from a job into stock (wrong part, fewer used).
  /// Linked to the PartUsage; that usage's net quantity is its consumption
  /// minus its returns.
  JOB_RETURN
  /// Cancels one earlier row exactly (reversalOfTransactionId).
  REVERSAL
  /// A part sold on an invoice's lines (invoiceId). Costed on the invoice.
  SALE
}

/// V1 supports quotations (Estimate) and two invoice concepts only.
/// Credit/debit notes are explicitly future scope.
enum InvoiceType {
  TAX_INVOICE
  PROFORMA
  /// What a customer already owed when the books began. Not a supply: no
  /// VAT, no income — receipts are taken against it like any invoice.
  OPENING_BALANCE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CHEQUE
  ONLINE
}

/// A reversal is never represented by editing the original row's status —
/// it is a new row with status REVERSED and reversalOf(Supplier)PaymentId
/// pointing back at the original, which stays COMPLETED forever.
enum PaymentStatus {
  COMPLETED
  REVERSED
}

enum ExpenseStatus {
  RECORDED
  VOID
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
  CANCELLED
}

/// Mirrors InvoiceType (no CREDIT_NOTE in V1) plus payment/expense voucher
/// types, so every document category that needs a human-readable number has
/// one.
enum DocumentType {
  JOB_CARD
  ESTIMATE
  TAX_INVOICE
  PROFORMA_INVOICE
  PURCHASE_ORDER
  PAYMENT_RECEIPT
  EXPENSE_VOUCHER
  SUPPLIER_PAYMENT
  JOURNAL_ENTRY
  CREDIT_NOTE
  FIXED_ASSET
  OPENING_BALANCE
  MONEY_TRANSFER
  CUSTOMER_ADVANCE
  OWNER_MONEY
  PAYMENT_VOUCHER
}

enum DocumentCategory {
  PHOTO
  INVOICE_PDF
  INSPECTION_REPORT
  EMPLOYEE_DOCUMENT
  OTHER
  /// A captured signature image (see Signature).
  SIGNATURE
  /// A supplier's bill or receipt kept against an expense or purchase.
  SUPPLIER_BILL
  /// A spoken note kept with a task (only when the speaker chose to keep it).
  VOICE_NOTE
}

/// Where in the job a photo was taken.
enum MediaStage {
  INTAKE
  INSPECTION
  DIAGNOSIS
  REPAIR
  QUALITY_CHECK
  DELIVERY
  GENERAL
}

/// What a signature confirms.
enum SignatureContext {
  QUOTATION_APPROVAL
  DELIVERY_HANDOVER
}

enum SignerType {
  CUSTOMER
  STAFF
}

// =============================================================================
// TENANT / ACCESS
// =============================================================================

model Organization {
  id                    String    @id @default(uuid(7)) @db.Uuid
  name                  String
  legalName             String?   @map("legal_name")
  taxNumber             String?   @map("tax_number")
  /// Whether the business charges VAT. When false, new lines default to 0%.
  /// Existing documents keep the rate they were priced at either way.
  isVatRegistered       Boolean   @default(true) @map("is_vat_registered")
  /// Standard VAT rate as a percentage, e.g. 5.00. Read through lib/tax —
  /// never hard-coded elsewhere.
  vatRate               Decimal   @default(5.00) @map("vat_rate") @db.Decimal(5, 2)
  address               String?
  phone                 String?
  email                 String?
  baseCurrency          String    @default("AED") @map("base_currency")
  /// Whether work orders open as the full step-by-step job card (inspection,
  /// diagnosis, approval, repair, quality check). Off: the simple job card —
  /// one person takes the vehicle in, bills it and hands it back.
  detailedJobCards      Boolean   @default(false) @map("detailed_job_cards")
  /// Menu items (their hrefs, from lib/nav.ts) the workshop chose not to show.
  /// Display only — permissions still decide what each user may open.
  hiddenMenus           String[]  @default([]) @map("hidden_menus")
  /// The books are closed up to and including this date: nothing may be
  /// booked, changed or voided on or before it (lib/accounting/periods.ts).
  booksClosedThrough    DateTime? @map("books_closed_through") @db.Date
  /// The date the books begin: every opening balance (accounts, customers)
  /// is booked on it (lib/accounting/opening-balances.ts).
  openingBalanceDate    DateTime? @map("opening_balance_date") @db.Date
  /// Where its supplies are made; VAT201 reports Box 1 by emirate.
  emirate               Emirate   @default(DUBAI)
  /// The company's dates (lib/compliance). Null until the workshop enters them
  /// from its licence, Memorandum of Association and FTA certificates.
  /// The month its financial year ends (12 = 31 December); the year ends on
  /// the last day of that month.
  financialYearEndMonth Int?      @map("financial_year_end_month") @db.SmallInt
  /// The end of its first financial year, which may be shorter or longer than
  /// twelve months; every later year ends on financialYearEndMonth.
  firstFinancialYearEnd DateTime? @map("first_financial_year_end") @db.Date
  /// The first VAT return period on the FTA's VAT registration certificate.
  /// Later periods follow it back to back, vatPeriodMonths long each.
  vatFirstPeriodStart   DateTime? @map("vat_first_period_start") @db.Date
  vatFirstPeriodEnd     DateTime? @map("vat_first_period_end") @db.Date
  /// 3 for quarterly returns, 1 for monthly.
  vatPeriodMonths       Int?      @map("vat_period_months") @db.SmallInt
  /// The corporate tax registration number from EmaraTax.
  corporateTaxNumber    String?   @map("corporate_tax_number")
  tradeLicenceNumber    String?   @map("trade_licence_number")
  tradeLicenceExpiry    DateTime? @map("trade_licence_expiry") @db.Date
  /// For the WPS salary file: the MOHRE establishment number (13 digits) and
  /// the routing code of the bank the salaries are paid from (9 digits).
  mohreEstablishmentId  String?   @map("mohre_establishment_id")
  wpsRoutingCode        String?   @map("wps_routing_code")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  branches                Branch[]
  users                   User[]
  roles                   Role[]
  customers               Customer[]
  vehicles                Vehicle[]
  appointments            Appointment[]
  jobCards                JobCard[]
  parts                   Part[]
  suppliers               Supplier[]
  purchases               Purchase[]
  invoices                Invoice[]
  payments                Payment[]
  supplierPayments        SupplierPayment[]
  expenses                Expense[]
  chartOfAccounts         ChartOfAccount[]
  journalEntries          JournalEntry[]
  employees               Employee[]
  payrolls                Payroll[]
  documentNumberSequences DocumentNumberSequence[]
  userRoles               UserRole[]
  rolePermissions         RolePermission[]
  jobStatusHistories      JobStatusHistory[]
  jobAssignments          JobAssignment[]
  inspections             Inspection[]
  inspectionItems         InspectionItem[]
  diagnoses               Diagnosis[]
  estimates               Estimate[]
  estimateItems           EstimateItem[]
  approvals               Approval[]
  approvalItems           ApprovalItem[]
  labours                 Labour[]
  partUsages              PartUsage[]
  workRecords             WorkRecord[]
  qualityChecks           QualityCheck[]
  purchaseItems           PurchaseItem[]
  inventoryTransactions   InventoryTransaction[]
  invoiceItems            InvoiceItem[]
  journalEntryLines       JournalEntryLine[]
  attendances             Attendance[]
  leaves                  Leave[]
  salaries                Salary[]
  payrollItems            PayrollItem[]
  auditLogs               AuditLog[]
  signatures              Signature[]
  documents               Document[]
  sessions                Session[]
  customerAccessTokens    CustomerAccessToken[]
  taxCodes                TaxCode[]
  paymentModes            PaymentMode[]
  vatFilings              VatFiling[]
  priorPeriodSummaries    PriorPeriodSummary[]

  creditNotes         CreditNote[]
  creditNoteItems     CreditNoteItem[]
  stockCounts         StockCount[]
  bankReconciliations BankReconciliation[]
  moneyTransfers      MoneyTransfer[]
  ownerMoney          OwnerMoney[]
  paymentVouchers     PaymentVoucher[]
  partners            Partner[]
  customerAdvances    CustomerAdvance[]
  advanceAllocations  CustomerAdvanceAllocation[]
  advanceRefunds      CustomerAdvanceRefund[]
  reconciledLines     ReconciledLine[]
  fixedAssets         FixedAsset[]
  assetDepreciations  AssetDepreciation[]

  ownerReimbursements OwnerReimbursement[]

  tasks       Task[]
  taskUpdates TaskUpdate[]

  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  designations Designation[]

  @@map("organizations")
}

model Branch {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  code            String
  name            String
  address         String?
  phone           String?
  /// The workshop's position. Staff can only check themselves in or out
  /// within `geofenceRadiusM` metres of it. Null: not set yet, so nobody can
  /// check themselves in (staff with attendance rights still can for them).
  latitude        Decimal? @db.Decimal(9, 6)
  longitude       Decimal? @db.Decimal(9, 6)
  geofenceRadiusM Int      @default(150) @map("geofence_radius_m")
  /// When the working day starts, "HH:MM" in Dubai time: the morning reminder
  /// to check in goes out then to anyone not checked in.
  shiftStartTime  String   @default("08:00") @map("shift_start_time")
  /// When the working day ends, "HH:MM" in Dubai time. A day left open past
  /// it is closed at this time and flagged for review.
  shiftEndTime    String   @default("20:00") @map("shift_end_time")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  tasks                   Task[]
  primaryUsers            User[]
  appointments            Appointment[]
  jobCards                JobCard[]
  purchases               Purchase[]
  estimates               Estimate[]
  invoices                Invoice[]
  expenses                Expense[]
  journalEntries          JournalEntry[]
  employees               Employee[]
  attendances             Attendance[]
  inventoryTransactions   InventoryTransaction[]
  documentNumberSequences DocumentNumberSequence[]
  userRoles               UserRole[]
  auditLogs               AuditLog[]
  documents               Document[]

  creditNotes     CreditNote[]
  stockCounts     StockCount[]
  advances        CustomerAdvance[]
  paymentVouchers PaymentVoucher[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("branches")
}

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  primaryBranchId    String?   @map("primary_branch_id") @db.Uuid
  /// Optional: a login made for an employee signs in with their employee
  /// code (`username`) and may have no email at all.
  email              String?
  /// The sign-in name of an employee's login: their employee code, upper case.
  username           String?
  passwordHash       String    @map("password_hash")
  /// The password was set by someone else (an employee's first password is
  /// their code): the next sign-in must choose their own before anything else.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  fullName           String    @map("full_name")
  phone              String?
  isActive           Boolean   @default(true) @map("is_active")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  primaryBranch Branch?      @relation(fields: [organizationId, primaryBranchId], references: [organizationId, id], onDelete: Restrict)

  userRoles                  UserRole[]             @relation("UserRoleUser")
  employee                   Employee?
  assignedJobAssignments     JobAssignment[]        @relation("JobAssignmentAssignedBy")
  jobStatusChanges           JobStatusHistory[]
  createdAppointments        Appointment[]
  createdJobCards            JobCard[]
  deliveredJobCards          JobCard[]              @relation("JobCardDeliveredBy")
  preparedEstimates          Estimate[]             @relation("EstimatePreparedBy")
  sentEstimates              Estimate[]             @relation("EstimateSentBy")
  recordedApprovals          Approval[]
  recordedQualityChecks      QualityCheck[]
  createdPurchases           Purchase[]             @relation("PurchaseCreatedBy")
  receivedPurchases          Purchase[]             @relation("PurchaseReceivedBy")
  inventoryAdjustments       InventoryTransaction[]
  createdInvoices            Invoice[]              @relation("InvoiceCreatedBy")
  issuedInvoices             Invoice[]              @relation("InvoiceIssuedBy")
  receivedPayments           Payment[]
  paidSupplierPayments       SupplierPayment[]
  recordedExpenses           Expense[]
  createdJournalEntries      JournalEntry[]         @relation("JournalEntryCreatedBy")
  postedJournalEntries       JournalEntry[]         @relation("JournalEntryPostedBy")
  approvedLeaves             Leave[]
  createdPayrolls            Payroll[]              @relation("PayrollCreatedBy")
  approvedPayrolls           Payroll[]              @relation("PayrollApprovedBy")
  paidPayrolls               Payroll[]              @relation("PayrollPaidBy")
  grantedUserRoles           UserRole[]             @relation("UserRoleAssignedBy")
  revokedUserRoles           UserRole[]             @relation("UserRoleRevokedBy")
  auditLogs                  AuditLog[]
  uploadedDocuments          Document[]             @relation("DocumentUploadedBy")
  deletedDocuments           Document[]             @relation("DocumentDeletedBy")
  capturedSignatures         Signature[]
  sessions                   Session[]
  issuedCustomerAccessTokens CustomerAccessToken[]

  vatFilingsFiled          VatFiling[]                 @relation("VatFilingFiledBy")
  priorPeriodsRecorded     PriorPeriodSummary[]        @relation("PriorPeriodRecordedBy")
  creditNotesCreated       CreditNote[]                @relation("CreditNoteCreatedBy")
  reconciliationsCreated   BankReconciliation[]        @relation("ReconciliationCreatedBy")
  moneyTransfersCreated    MoneyTransfer[]             @relation("MoneyTransferCreatedBy")
  ownerMoneyCreated        OwnerMoney[]                @relation("OwnerMoneyCreatedBy")
  ownerMoneyOwned          OwnerMoney[]                @relation("OwnerMoneyOwner")
  paymentVouchersCreated   PaymentVoucher[]            @relation("PaymentVoucherCreatedBy")
  advancesReceived         CustomerAdvance[]           @relation("CustomerAdvanceReceivedBy")
  advancesCancelled        CustomerAdvance[]           @relation("CustomerAdvanceCancelledBy")
  advanceAllocationsMade   CustomerAdvanceAllocation[] @relation("AdvanceAllocationCreatedBy")
  advanceAllocationsUndone CustomerAdvanceAllocation[] @relation("AdvanceAllocationReversedBy")
  advanceRefundsMade       CustomerAdvanceRefund[]     @relation("AdvanceRefundCreatedBy")
  advanceRefundsReversed   CustomerAdvanceRefund[]     @relation("AdvanceRefundReversedBy")
  reconciliationsCompleted BankReconciliation[]        @relation("ReconciliationCompletedBy")
  fixedAssetsCreated       FixedAsset[]                @relation("FixedAssetCreatedBy")

  expensesPaidPersonally Expense[]            @relation("ExpensePaidPersonallyBy")
  reimbursementsReceived OwnerReimbursement[] @relation("OwnerReimbursementPerson")
  reimbursementsRecorded OwnerReimbursement[] @relation("OwnerReimbursementRecordedBy")

  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  createdTasks        Task[]             @relation("TaskCreatedBy")
  billsMatched        Purchase[]         @relation("PurchaseBillMatchedBy")
  stockCounts         StockCount[]
  completedTasks      Task[]             @relation("TaskCompletedBy")
  taskUpdates         TaskUpdate[]
  reviewedAttendances Attendance[]       @relation("AttendanceReviewedBy")

  @@unique([organizationId, id])
  @@unique([organizationId, email])
  @@unique([organizationId, username])
  @@index([organizationId])
  @@index([organizationId, primaryBranchId])
  @@map("users")
}

/// Server-side session store for cookie-based staff auth. Only tokenHash is
/// stored (the raw token lives solely in the httpOnly cookie) — a DB leak
/// alone can never yield a usable session. Logout/expiry is a soft-delete
/// (revokedAt), never a row DELETE, matching the revocation pattern used
/// everywhere else in this schema (rule 19) and keeping session history
/// auditable.
model Session {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, userId])
  @@map("sessions")
}

model Role {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  userRoles       UserRole[]
  rolePermissions RolePermission[]
  designations    Designation[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

/// A position in the workshop (Technician, Supervisor, Manager…), set up
/// under HR. What it may do in the app is its role's permissions: an
/// employee's login is given their designation's role, and moves to the new
/// one when their designation changes. Never deleted, only made inactive.
model Designation {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  roleId         String?  @map("role_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         Role?        @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)

  employees Employee[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, roleId])
  @@map("designations")
}

/// Global platform capability catalog. Deliberately has NO organization_id:
/// permissions are platform-defined code (e.g. "invoice.approve"), not
/// tenant-owned data. Relations to this model are plain (not composite) FKs.
model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  description String?
  module      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// branchId is nullable by design:
///   branchId = NULL     -> organization-wide role grant
///   branchId = <branch> -> role grant scoped to that branch only
/// Backend authorization must enforce that a branch-scoped grant cannot
/// access resources belonging to a different branch — see
/// docs/07-security/authorization.md.
///
/// Revocation is a soft-delete (revokedAt/revokedByUserId), never a hard
/// DELETE — mirrors the JobAssignment history-preservation pattern (rule
/// 10) and keeps role-grant history queryable without relying solely on
/// AuditLog reconstruction.
model UserRole {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  roleId           String    @map("role_id") @db.Uuid
  branchId         String?   @map("branch_id") @db.Uuid
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  revokedByUserId  String?   @map("revoked_by_user_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("UserRoleUser", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  role         Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict, map: "user_roles_branch_fkey")
  assignedBy   User?        @relation("UserRoleAssignedBy", fields: [organizationId, assignedByUserId], references: [organizationId, id], onDelete: Restrict)
  revokedBy    User?        @relation("UserRoleRevokedBy", fields: [organizationId, revokedByUserId], references: [organizationId, id], onDelete: Restrict)

  // Branch-scoped grants: branch_id is non-null so Postgres' NULL-distinctness
  // quirk doesn't apply. Extended with revoked_at IS NULL so a revoked-then-
  // regranted role doesn't collide with a still-active one.
  @@unique([userId, roleId, branchId], map: "user_roles_branch_scoped_unique", where: raw("revoked_at IS NULL"))
  // Organization-wide grants (branch_id IS NULL), same revoked_at guard.
  @@unique([userId, roleId], map: "user_roles_orgwide_unique", where: raw("branch_id IS NULL AND revoked_at IS NULL"))
  @@index([organizationId])
  @@index([organizationId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  permissionId   String   @map("permission_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([organizationId])
  @@index([permissionId])
  @@map("role_permissions")
}

// =============================================================================
// CUSTOMER / VEHICLE
// =============================================================================

model Customer {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  customerCode   String?  @map("customer_code")
  name           String
  phone          String
  email          String?
  address        String?
  taxNumber      String?  @map("tax_number")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  vehicles           Vehicle[]
  jobCards           JobCard[]
  appointments       Appointment[]
  estimates          Estimate[]
  invoices           Invoice[]
  approvals          Approval[]
  jobStatusDecisions JobStatusHistory[]
  signatures         Signature[]

  creditNotes  CreditNote[]
  advances     CustomerAdvance[]
  journalLines JournalEntryLine[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, name])
  @@index([organizationId, phone])
  @@map("customers")
}

model Vehicle {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  plateNumber    String   @map("plate_number")
  plateEmirate   String?  @map("plate_emirate")
  vin            String?
  make           String
  model          String
  year           Int?
  color          String?
  lastMileage    Int?     @map("last_mileage")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)

  appointments Appointment[]
  jobCards     JobCard[]
  estimates    Estimate[]
  invoices     Invoice[]
  advances     CustomerAdvance[]

  @@unique([organizationId, id])
  @@unique([organizationId, plateNumber])
  @@unique([organizationId, vin])
  @@index([organizationId])
  @@index([organizationId, customerId])
  @@map("vehicles")
}

model Appointment {
  id                       String            @id @default(uuid(7)) @db.Uuid
  organizationId           String            @map("organization_id") @db.Uuid
  branchId                 String            @map("branch_id") @db.Uuid
  customerId               String            @map("customer_id") @db.Uuid
  vehicleId                String?           @map("vehicle_id") @db.Uuid
  scheduledAt              DateTime          @map("scheduled_at") @db.Timestamptz
  estimatedDurationMinutes Int?              @map("estimated_duration_minutes")
  status                   AppointmentStatus @default(SCHEDULED)
  notes                    String?
  createdByUserId          String            @map("created_by_user_id") @db.Uuid
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  customer     Customer     @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  vehicle      Vehicle?     @relation(fields: [organizationId, vehicleId], references: [organizationId, id], onDelete: Restrict)
  createdBy    User         @relation(fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)

  jobCards JobCard[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, branchId, scheduledAt])
  @@index([organizationId, customerId])
  @@index([organizationId, vehicleId])
  @@map("appointments")
}

// =============================================================================
// WORKSHOP
// =============================================================================

/// customerId is the customer the job was opened for, captured at check-in
/// from the vehicle's owner at that moment and never rewritten. A vehicle
/// can change hands; its past jobs still belong to whoever brought it in, so
/// service history, approvals and invoices keep the right person. Anything
/// about the job reads jobCard.customer — never vehicle.customer.
model JobCard {
  id                String        @id @default(uuid(7)) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  branchId          String        @map("branch_id") @db.Uuid
  vehicleId         String        @map("vehicle_id") @db.Uuid
  customerId        String        @map("customer_id") @db.Uuid
  appointmentId     String?       @map("appointment_id") @db.Uuid
  jobNumber         String        @map("job_number")
  status            JobCardStatus @default(ARRIVED)
  odometerReading   Int?          @map("odometer_reading")
  customerComplaint String?       @map("customer_complaint")
  openedAt          DateTime      @default(now()) @map("opened_at") @db.Timestamptz
  closedAt          DateTime?     @map("closed_at") @db.Timestamptz
  /// Vehicle handed back to the customer (PAID → DELIVERED).
  deliveredAt       DateTime?     @map("delivered_at") @db.Timestamptz
  deliveredByUserId String?       @map("delivered_by_user_id") @db.Uuid
  deliveryNotes     String?       @map("delivery_notes")
  createdByUserId   String        @map("created_by_user_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  vehicle      Vehicle      @relation(fields: [organizationId, vehicleId], references: [organizationId, id], onDelete: Restrict)
  customer     Customer     @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  appointment  Appointment? @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Restrict)
  createdBy    User         @relation(fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  deliveredBy  User?        @relation("JobCardDeliveredBy", fields: [organizationId, deliveredByUserId], references: [organizationId, id], onDelete: Restrict)

  statusHistory JobStatusHistory[]
  assignments   JobAssignment[]
  inspections   Inspection[]
  diagnoses     Diagnosis[]
  estimates     Estimate[]
  labours       Labour[]
  partUsages    PartUsage[]
  workRecords   WorkRecord[]
  qualityChecks QualityCheck[]
  invoices      Invoice[]
  advances      CustomerAdvance[]
  documents     Document[]
  signatures    Signature[]
  tasks         Task[]
  expenses      Expense[]

  @@unique([organizationId, id])
  @@unique([organizationId, jobNumber])
  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, vehicleId])
  @@index([organizationId, customerId])
  @@index([organizationId, status])
  @@index([organizationId, branchId, status])
  @@map("job_cards")
}

/// Immutable append-only log: rows are never edited after insert (rule 10).
/// Exactly one actor per row: the staff user who made the change, or the
/// customer whose own decision caused it (online quotation approval).
model JobStatusHistory {
  id                  String         @id @default(uuid(7)) @db.Uuid
  organizationId      String         @map("organization_id") @db.Uuid
  jobCardId           String         @map("job_card_id") @db.Uuid
  fromStatus          JobCardStatus? @map("from_status")
  toStatus            JobCardStatus  @map("to_status")
  changedByUserId     String?        @map("changed_by_user_id") @db.Uuid
  changedByCustomerId String?        @map("changed_by_customer_id") @db.Uuid
  changedAt           DateTime       @default(now()) @map("changed_at") @db.Timestamptz

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobCard           JobCard      @relation(fields: [organizationId, jobCardId], references: [organizationId, id], onDelete: Cascade)
  changedBy         User?        @relation(fields: [organizationId, changedByUserId], references: [organizationId, id], onDelete: Restrict)
  changedByCustomer Customer?    @relation(fields: [organizationId, changedByCustomerId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, jobCardId, changedAt])
  @@map("job_status_history")
}

/// Historical rows are never overwritten (rule 10): "unassigning" sets
/// unassignedAt rather than deleting/editing the row. The partial unique
/// index below enforces rule 9 (only one active PRIMARY assignment) at the
/// database level, not just in application code.
model JobAssignment {
  id               String         @id @default(uuid(7)) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  jobCardId        String         @map("job_card_id") @db.Uuid
  employeeId       String         @map("employee_id") @db.Uuid
  assignedByUserId String         @map("assigned_by_user_id") @db.Uuid
  assignmentRole   AssignmentRole @default(SUPPORT) @map("assignment_role")
  assignedAt       DateTime       @default(now()) @map("assigned_at") @db.Timestamptz
  unassignedAt     DateTime?      @map("unassigned_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobCard      JobCard      @relation(fields: [organizationId, jobCardId], references: [organizationId, id], onDelete: Cascade)
  employee     Employee     @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  assignedBy   User         @relation("JobAssignmentAssignedBy", fields: [organizationId, assignedByUserId], references: [organizationId, id], onDelete: Restrict)

  @@unique([jobCardId], map: "one_active_primary_assignment_per_job_card", where: raw("assignment_role = 'PRIMARY' AND unassigned_at IS NULL"))
  @@index([organizationId])
  @@index([organizationId, jobCardId])
  @@index([organizationId, employeeId])
  @@map("job_assignments")
}

model Inspection {
  id                    String           @id @default(uuid(7)) @db.Uuid
  organizationId        String           @map("organization_id") @db.Uuid
  jobCardId             String           @map("job_card_id") @db.Uuid
  inspectedByEmployeeId String           @map("inspected_by_employee_id") @db.Uuid
  status                InspectionStatus @default(IN_PROGRESS)
  summary               String?
  inspectedAt           DateTime         @default(now()) @map("inspected_at") @db.Timestamptz
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobCard             JobCard      @relation(fields: [organizationId, jobCardId], references: [organizationId, id], onDelete: Cascade)
  inspectedByEmployee Employee     @relation(fields: [organizationId, inspectedByEmployeeId], references: [organizationId, id], onDelete: Restrict)

  items     InspectionItem[]
  diagnoses Diagnosis[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, jobCardId])
  @@map("inspections")
}

model InspectionItem {
  id             String               @id @default(uuid(7)) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  inspectionId   String               @map("inspection_id") @db.Uuid
  category       String?
  description    String
  result         InspectionItemResult
  notes          String?
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inspection   Inspection   @relation(fields: [organizationId, inspectionId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, inspectionId])
  @@map("inspection_items")
}

model Diagnosis {
  id                    String   @id @default(uuid(7)) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  jobCardId             String   @map("job_card_id") @db.Uuid
  inspectionId          String?  @map("inspection_id") @db.Uuid
  diagnosedByEmployeeId String   @map("diagnosed_by_employee_id") @db.Uuid
  findings              String
  recommendedAction     String?  @map("recommended_action")
  diagnosedAt           DateTime @default(now()) @map("diagnosed_at") @db.Timestamptz
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobCard             JobCard      @relation(fields: [organizationId, jobCardId], references: [organizationId, id], onDelete: Cascade)
  inspection          Inspection?  @relation(fields: [organizationId, inspectionId], references: [organizationId, id], onDelete: Restrict)
  diagnosedByEmployee Employee     @relation(fields: [organizationId, diagnosedByEmployeeId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, jobCardId])
  @@map("diagnoses")
}

/// Represents PROPOSED work (rule 13). previousVersionId makes the revision
/// chain explicit (in addition to `version`), so "what did this replace" is
/// a direct lookup. The original estimate and its Approval history are
/// never overwritten — a revision is always a new row.
model Estimate {
  id                String         @id @default(uuid(7)) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  /// Null for a quotation raised straight for a customer, with no work
  /// order behind it. A workflow quotation always carries its job card.
  jobCardId         String?        @map("job_card_id") @db.Uuid
  /// The quotation's own branch, customer and vehicle. Backfilled from the
  /// job card for every quotation that had one, so a workflow quotation
  /// answers "whose is this?" without the join, and a standalone one can
  /// answer it at all. Vehicle is optional — a customer may ask for a price
  /// before bringing the car in.
  branchId          String         @map("branch_id") @db.Uuid
  customerId        String         @map("customer_id") @db.Uuid
  vehicleId         String?        @map("vehicle_id") @db.Uuid
  previousVersionId String?        @map("previous_version_id") @db.Uuid
  estimateNumber    String         @map("estimate_number")
  version           Int            @default(1)
  kind              EstimateKind   @default(ORIGINAL)
  /// Why the work is needed — used for ADDITIONAL work found during repair.
  notes             String?
  status            EstimateStatus @default(DRAFT)
  /// Discount on the whole bill, taken after the lines' own discounts: a
  /// percentage or a fixed amount (type + value, as entered), and the AED
  /// it came to. `subtotal` is already net of it — the taxable amount —
  /// so total = subtotal + VAT holds with or without a discount.
  discountType      DiscountType?  @map("discount_type")
  discountValue     Decimal?       @map("discount_value") @db.Decimal(14, 2)
  discountAmount    Decimal        @default(0) @map("discount_amount") @db.Decimal(14, 2)
  subtotal          Decimal        @db.Decimal(14, 2)
  taxAmount         Decimal        @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount       Decimal        @map("total_amount") @db.Decimal(14, 2)
  preparedByUserId  String         @map("prepared_by_user_id") @db.Uuid
  sentByUserId      String?        @map("sent_by_user_id") @db.Uuid
  validUntil        DateTime?      @map("valid_until") @db.Date
  sentAt            DateTime?      @map("sent_at") @db.Timestamptz
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobCard         JobCard?     @relation(fields: [organizationId, jobCardId], references: [organizationId, id], onDelete: Cascade)
  branch          Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  customer        Customer     @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  vehicle         Vehicle?     @relation(fields: [organizationId, vehicleId], references: [organizationId, id], onDelete: Restrict)
  previousVersion Estimate?    @relation("EstimateRevision", fields: [organizationId, previousVersionId], references: [organizationId, id], onDelete: Restrict)
  nextVersions    Estimate[]   @relation("EstimateRevision")
  preparedBy      User         @relation("EstimatePreparedBy", fields: [organizationId, preparedByUserId], references: [organizationId, id], onDelete: Restrict)
  sentBy          User?        @relation("EstimateSentBy", fields: [organizationId, sentByUserId], references: [organizationId, id], onDelete: Restrict)

  items     EstimateItem[]
  approvals Approval[]

  @@unique([organizationId, id])
  @@unique([organizationId, estimateNumber])
  @@index([organizationId])
  @@index([organizationId, jobCardId])
  @@index([organizationId, branchId])
  @@index([organizationId, customerId])
  @@index([organizationId, vehicleId])
  @@index([organizationId, previousVersionId])
  @@index([organizationId, jobCardId, kind])
  @@map("estimates")
}

model EstimateItem {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  estimateId     String           @map("estimate_id") @db.Uuid
  itemType       EstimateItemType @map("item_type")
  partId         String?          @map("part_id") @db.Uuid
  description    String
  quantity       Decimal          @db.Decimal(12, 3)
  unitPrice      Decimal          @map("unit_price") @db.Decimal(14, 2)
  lineTotal      Decimal          @map("line_total") @db.Decimal(14, 2)
  taxRate        Decimal?         @map("tax_rate") @db.Decimal(5, 2)
  taxAmount      Decimal?         @map("tax_amount") @db.Decimal(14, 2)
  /// The tax code chosen (Accounting → Tax codes). Its rate and treatment
  /// are copied onto the record when saved, so changing the code later never
  /// alters an issued document.
  taxCodeId      String?          @map("tax_code_id") @db.Uuid
  /// How the line is treated for VAT; its rate follows from it.
  vatTreatment   VatTreatment     @default(STANDARD) @map("vat_treatment")
  /// The line's own discount: a percentage or a fixed amount (type +
  /// value, as entered), and the AED it came to. `lineTotal` is net of it.
  /// `taxAmount` is the VAT on this line after its share of the bill
  /// discount too.
  discountType   DiscountType?    @map("discount_type")
  discountValue  Decimal?         @map("discount_value") @db.Decimal(14, 2)
  discountAmount Decimal          @default(0) @map("discount_amount") @db.Decimal(14, 2)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  estimate     Estimate     @relation(fields: [organizationId, estimateId], references: [organizationId, id], onDelete: Cascade)
  part         Part?        @relation(fields: [organizationId, partId], references: [organizationId, id], onDelete: Restrict)
  taxCode      TaxCode?     @relation(fields: [organizationId, taxCodeId], references: [organizationId, id], onDelete: Restrict)

  approvalItems ApprovalItem[]
  labours       Labour[]
  partUsages    PartUsage[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, estimateId])
  @@index([organizationId, partId])
  @@map("estimate_items")
}

/// Represents customer AUTHORIZATION (rule 14) of a specific Estimate.
/// No dedicated signature field — a captured signature, if ever needed, is
/// a Document row with entityType = "Approval".
model Approval {
  id               String         @id @default(uuid(7)) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  estimateId       String         @map("estimate_id") @db.Uuid
  status           ApprovalStatus
  approvalMethod   ApprovalMethod @map("approval_method")
  approvedAt       DateTime?      @map("approved_at") @db.Timestamptz
  /// When the customer made the decision (approved or rejected).
  decidedAt        DateTime       @default(now()) @map("decided_at") @db.Timestamptz
  /// The customer who made the decision — always the customer, never staff.
  customerId       String         @map("customer_id") @db.Uuid
  /// Staff member who recorded a decision given in person / by phone etc.
  /// NULL for ONLINE decisions the customer made themselves. The staff
  /// member who sent the quotation is Estimate.sentByUserId.
  recordedByUserId String?        @map("recorded_by_user_id") @db.Uuid
  notes            String?
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  estimate     Estimate     @relation(fields: [organizationId, estimateId], references: [organizationId, id], onDelete: Restrict)
  customer     Customer     @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  recordedBy   User?        @relation(fields: [organizationId, recordedByUserId], references: [organizationId, id], onDelete: Restrict)

  items     ApprovalItem[]
  signature Signature?

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, estimateId])
  @@index([organizationId, customerId])
  @@map("approvals")
}

model ApprovalItem {
  id             String               @id @default(uuid(7)) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  approvalId     String               @map("approval_id") @db.Uuid
  estimateItemId String               @map("estimate_item_id") @db.Uuid
  decision       ApprovalItemDecision
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  approval     Approval     @relation(fields: [organizationId, approvalId], references: [organizationId, id], onDelete: Cascade)
  estimateItem EstimateItem @relation(fields: [organizationId, estimateItemId], references: [organizationId, id], onDelete: Restrict)

  @@unique([approvalId, estimateItemId])
  @@index([organizationId])
  @@index([organizationId, estimateItemId])
  @@map("approval_items")
}

/// Represents the BILLABLE labour charge: rate x hours, feeds InvoiceItem.
/// Always attributable to an Employee (rule 12), never to a User directly.
/// workRecordId is an optional traceability link back to the operational
/// time-log entry this charge was derived from.
model Labour {
  id                    String   @id @default(uuid(7)) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  jobCardId             String   @map("job_card_id") @db.Uuid
  performedByEmployeeId String   @map("performed_by_employee_id") @db.Uuid
  workRecordId          String?  @map("work_record_id") @db.Uuid
  /// The approved estimate line this labour fulfils. NULL = additional work
  /// that the customer has not approved (never charged automatically).
  estimateItemId        String?  @map("estimate_item_id") @db.Uuid
  description           String
  hours                 Decimal  @db.Decimal(8, 2)
  rate                  Decimal  @db.Decimal(14, 2)
  amount                Decimal  @db.Decimal(14, 2)
  performedAt           DateTime @default(now()) @map("performed_at") @db.Timestamptz
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobCard             JobCard       @relation(fields: [organizationId, jobCardId], references: [organizationId, id], onDelete: Cascade)
  performedByEmployee Employee      @relation(fields: [organizationId, performedByEmployeeId], references: [organizationId, id], onDelete: Restrict)
  workRecord          WorkRecord?   @relation(fields: [organizationId, workRecordId], references: [organizationId, id], onDelete: Restrict)
  estimateItem        EstimateItem? @relation(fields: [organizationId, estimateItemId], references: [organizationId, id], onDelete: Restrict)

  invoiceItems InvoiceItem[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, jobCardId])
  @@index([organizationId, performedByEmployeeId])
  @@index([organizationId, workRecordId])
  @@index([organizationId, estimateItemId])
  @@map("labours")
}

/// Represents ACTUAL parts consumed (rule 15). unitCost/unitPrice are
/// snapshotted at time of use, not read live from Part.
model PartUsage {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  jobCardId        String   @map("job_card_id") @db.Uuid
  partId           String   @map("part_id") @db.Uuid
  usedByEmployeeId String   @map("used_by_employee_id") @db.Uuid
  /// The approved estimate line this part fulfils. NULL = additional work
  /// that the customer has not approved (never charged automatically).
  estimateItemId   String?  @map("estimate_item_id") @db.Uuid
  quantity         Decimal  @db.Decimal(12, 3)
  unitCost         Decimal  @map("unit_cost") @db.Decimal(14, 2)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(14, 2)
  usedAt           DateTime @default(now()) @map("used_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobCard        JobCard       @relation(fields: [organizationId, jobCardId], references: [organizationId, id], onDelete: Cascade)
  part           Part          @relation(fields: [organizationId, partId], references: [organizationId, id], onDelete: Restrict)
  usedByEmployee Employee      @relation(fields: [organizationId, usedByEmployeeId], references: [organizationId, id], onDelete: Restrict)
  estimateItem   EstimateItem? @relation(fields: [organizationId, estimateItemId], references: [organizationId, id], onDelete: Restrict)

  invoiceItems          InvoiceItem[]
  inventoryTransactions InventoryTransaction[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, jobCardId])
  @@index([organizationId, partId])
  @@index([organizationId, estimateItemId])
  @@map("part_usages")
}

/// Operational time-log of ACTUAL technician work sessions — employee
/// attribution + productivity tracking. Deliberately kept separate from
/// Labour (the billable charge); Labour optionally references back to the
/// WorkRecord it was derived from, never the other way around.
model WorkRecord {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  jobCardId      String    @map("job_card_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  startedAt      DateTime  @map("started_at") @db.Timestamptz
  endedAt        DateTime? @map("ended_at") @db.Timestamptz
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobCard      JobCard      @relation(fields: [organizationId, jobCardId], references: [organizationId, id], onDelete: Cascade)
  employee     Employee     @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)

  labours Labour[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, jobCardId])
  @@index([organizationId, employeeId])
  @@map("work_records")
}

/// A quality check of the repair. Append-only history: every check is a new
/// row (a failed check followed by a passed re-check leaves both). The
/// employee who checked the vehicle is recorded, plus the user who entered
/// it, matching Inspection/Diagnosis (work is attributed to Employees).
model QualityCheck {
  id                  String             @id @default(uuid(7)) @db.Uuid
  organizationId      String             @map("organization_id") @db.Uuid
  jobCardId           String             @map("job_card_id") @db.Uuid
  checkedByEmployeeId String             @map("checked_by_employee_id") @db.Uuid
  recordedByUserId    String             @map("recorded_by_user_id") @db.Uuid
  status              QualityCheckStatus
  notes               String?
  /// Required when FAILED: what must be corrected before the next check.
  correctionsRequired String?            @map("corrections_required")
  checkedAt           DateTime           @default(now()) @map("checked_at") @db.Timestamptz
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobCard           JobCard      @relation(fields: [organizationId, jobCardId], references: [organizationId, id], onDelete: Cascade)
  checkedByEmployee Employee     @relation(fields: [organizationId, checkedByEmployeeId], references: [organizationId, id], onDelete: Restrict)
  recordedBy        User         @relation(fields: [organizationId, recordedByUserId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, jobCardId, checkedAt])
  @@index([organizationId, checkedByEmployeeId])
  @@map("quality_checks")
}

// =============================================================================
// INVENTORY
// =============================================================================

/// No current_stock field, by design (rules 20-21): stock levels are always
/// derived at query time from SUM(InventoryTransaction.quantity) grouped by
/// part + branch, never stored as a single mutable counter.
model Part {
  id                  String   @id @default(uuid(7)) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  sku                 String
  name                String
  description         String?
  unitOfMeasure       String   @map("unit_of_measure")
  defaultCostPrice    Decimal? @map("default_cost_price") @db.Decimal(14, 2)
  defaultSellingPrice Decimal? @map("default_selling_price") @db.Decimal(14, 2)
  defaultTaxRate      Decimal? @map("default_tax_rate") @db.Decimal(5, 2)
  preferredSupplierId String?  @map("preferred_supplier_id") @db.Uuid
  reorderLevel        Decimal? @map("reorder_level") @db.Decimal(12, 3)
  category            String?
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  preferredSupplier Supplier?    @relation(fields: [organizationId, preferredSupplierId], references: [organizationId, id], onDelete: Restrict)

  estimateItems         EstimateItem[]
  purchaseItems         PurchaseItem[]
  partUsages            PartUsage[]
  inventoryTransactions InventoryTransaction[]
  invoiceItems          InvoiceItem[]
  creditNoteItems       CreditNoteItem[]

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, preferredSupplierId])
  @@index([organizationId, category])
  @@map("parts")
}

model Supplier {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  /// The supplier's 15-digit TRN, digits only: how a scanned bill finds its supplier.
  taxNumber      String?  @map("tax_number")
  contactName    String?  @map("contact_name")
  phone          String?
  email          String?
  address        String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  parts        Part[]
  purchases    Purchase[]
  journalLines JournalEntryLine[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, taxNumber])
  @@map("suppliers")
}

model Purchase {
  id                    String             @id @default(uuid(7)) @db.Uuid
  organizationId        String             @map("organization_id") @db.Uuid
  branchId              String             @map("branch_id") @db.Uuid
  supplierId            String             @map("supplier_id") @db.Uuid
  purchaseNumber        String             @map("purchase_number")
  status                PurchaseStatus     @default(DRAFT)
  /// The supplier's own invoice / delivery note number and date.
  supplierInvoiceNumber String?            @map("supplier_invoice_number")
  supplierInvoiceDate   DateTime?          @map("supplier_invoice_date") @db.Date
  /// The supplier's tax invoice: still to come (parts bought for cash, the
  /// bill follows), matched, or never coming (a shop not registered for
  /// VAT). Input VAT is claimed only once it is RECEIVED, on its date.
  billStatus            PurchaseBillStatus @default(PENDING) @map("bill_status")
  billReceivedOn        DateTime?          @map("bill_received_on") @db.Date
  /// The bill's own figures, as typed from it when matched — kept beside
  /// what was recorded, so a difference stays visible.
  billSubtotal          Decimal?           @map("bill_subtotal") @db.Decimal(14, 2)
  billTaxAmount         Decimal?           @map("bill_tax_amount") @db.Decimal(14, 2)
  billTotalAmount       Decimal?           @map("bill_total_amount") @db.Decimal(14, 2)
  billMatchedByUserId   String?            @map("bill_matched_by_user_id") @db.Uuid
  billNote              String?            @map("bill_note")
  notes                 String?
  /// The taxable amount: the lines after their own discounts, less the bill discount.
  subtotal              Decimal?           @db.Decimal(14, 2)
  taxAmount             Decimal?           @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount           Decimal?           @map("total_amount") @db.Decimal(14, 2)
  /// A trade discount on the whole bill, taken after the lines' own
  /// discounts and shared across the lines to the fil (each line's
  /// `netAmount`). It lowers what the stock cost and the input VAT; it is
  /// never booked as income.
  billDiscountType      DiscountType?      @map("bill_discount_type")
  billDiscountValue     Decimal?           @map("bill_discount_value") @db.Decimal(14, 2)
  billDiscountAmount    Decimal            @default(0) @map("bill_discount_amount") @db.Decimal(14, 2)
  /// The supplier's round-off after VAT ("adjusted amount" on the bill), plus
  /// or minus, at most 5.00 either way — outside VAT. total = subtotal + VAT +
  /// this. Owed, and booked to Rounding adjustments, once the whole purchase
  /// is received.
  roundingAdjustment    Decimal            @default(0) @map("rounding_adjustment") @db.Decimal(14, 2)
  /// When the supplier expects to be paid ("pay later"). Suppliers owed ages
  /// the bill from it; without one, from the bill's date as before.
  dueDate               DateTime?          @map("due_date") @db.Date
  orderedAt             DateTime           @default(now()) @map("ordered_at") @db.Timestamptz
  expectedAt            DateTime?          @map("expected_at") @db.Timestamptz
  receivedAt            DateTime?          @map("received_at") @db.Timestamptz
  receivedByUserId      String?            @map("received_by_user_id") @db.Uuid
  journalEntryId        String?            @map("journal_entry_id") @db.Uuid
  createdByUserId       String             @map("created_by_user_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch        Branch        @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  supplier      Supplier      @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  journalEntry  JournalEntry? @relation(fields: [organizationId, journalEntryId], references: [organizationId, id], onDelete: Restrict)
  createdBy     User          @relation("PurchaseCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  receivedBy    User?         @relation("PurchaseReceivedBy", fields: [organizationId, receivedByUserId], references: [organizationId, id], onDelete: Restrict)
  billMatchedBy User?         @relation("PurchaseBillMatchedBy", fields: [organizationId, billMatchedByUserId], references: [organizationId, id], onDelete: Restrict)

  items            PurchaseItem[]
  supplierPayments SupplierPayment[]

  @@unique([organizationId, id])
  @@unique([organizationId, purchaseNumber])
  /// The same supplier invoice can't be entered twice (cancelled entries excepted).
  @@unique([organizationId, supplierId, supplierInvoiceNumber], map: "one_live_purchase_per_supplier_invoice", where: raw("supplier_invoice_number IS NOT NULL AND status <> 'CANCELLED'"))
  @@index([organizationId, billStatus])
  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, supplierId])
  @@index([organizationId, status])
  @@map("purchases")
}

model PurchaseItem {
  id               String        @id @default(uuid(7)) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  purchaseId       String        @map("purchase_id") @db.Uuid
  partId           String        @map("part_id") @db.Uuid
  quantityOrdered  Decimal       @map("quantity_ordered") @db.Decimal(12, 3)
  quantityReceived Decimal       @default(0) @map("quantity_received") @db.Decimal(12, 3)
  unitCost         Decimal       @map("unit_cost") @db.Decimal(14, 2)
  taxRate          Decimal?      @map("tax_rate") @db.Decimal(5, 2)
  /// VAT on the whole line, after its own discount and its share of the bill discount.
  taxAmount        Decimal?      @map("tax_amount") @db.Decimal(14, 2)
  /// The line's own trade discount: a percentage or a fixed amount (type +
  /// value, as entered), and the AED it came to on the quantity ordered.
  discountType     DiscountType? @map("discount_type")
  discountValue    Decimal?      @map("discount_value") @db.Decimal(14, 2)
  discountAmount   Decimal       @default(0) @map("discount_amount") @db.Decimal(14, 2)
  /// What the whole line costs after its own discount and its share of the
  /// bill discount, before VAT. Set only on a purchase with a discount: then
  /// stock received is valued from it (lib/inventory/purchase-value.ts).
  /// Empty on every other line, which is valued exactly as before discounts
  /// existed.
  netAmount        Decimal?      @map("net_amount") @db.Decimal(14, 2)
  /// The tax code chosen (Accounting → Tax codes). Its rate and treatment
  /// are copied onto the record when saved, so changing the code later never
  /// alters an issued document.
  taxCodeId        String?       @map("tax_code_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchase     Purchase     @relation(fields: [organizationId, purchaseId], references: [organizationId, id], onDelete: Cascade)
  part         Part         @relation(fields: [organizationId, partId], references: [organizationId, id], onDelete: Restrict)
  taxCode      TaxCode?     @relation(fields: [organizationId, taxCodeId], references: [organizationId, id], onDelete: Restrict)

  inventoryTransactions InventoryTransaction[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, purchaseId])
  @@index([organizationId, partId])
  @@map("purchase_items")
}

/// Append-only stock ledger (rules 20-21). quantity is signed: positive
/// increases stock, negative decreases it. Current stock is always
/// SUM(quantity) grouped by part + branch, never a stored counter.
/// purchaseItemId/partUsageId are nullable "one of these, or neither for a
/// manual adjustment" source references (avoids a fragile polymorphic FK).
///
/// NOTE: this signed-quantity ledger pattern is deliberately NOT reused for
/// financial receipts (see Payment) — physical stock movement and cash
/// receipts are different domains with different audit-friendliness needs.
model InventoryTransaction {
  id                      String                   @id @default(uuid(7)) @db.Uuid
  organizationId          String                   @map("organization_id") @db.Uuid
  branchId                String                   @map("branch_id") @db.Uuid
  partId                  String                   @map("part_id") @db.Uuid
  transactionType         InventoryTransactionType @map("transaction_type")
  quantity                Decimal                  @db.Decimal(12, 3)
  unitCost                Decimal?                 @map("unit_cost") @db.Decimal(14, 2)
  purchaseItemId          String?                  @map("purchase_item_id") @db.Uuid
  partUsageId             String?                  @map("part_usage_id") @db.Uuid
  /// SALE: the invoice whose part lines took it out of stock (or, positive,
  /// put it back when the invoice was changed or voided).
  invoiceId               String?                  @map("invoice_id") @db.Uuid
  /// CUSTOMER_RETURN: the credit note the part came back on (negative when
  /// the credit note was voided).
  creditNoteId            String?                  @map("credit_note_id") @db.Uuid
  /// ADJUSTMENT: the stock count that found the difference.
  stockCountId            String?                  @map("stock_count_id") @db.Uuid
  performedByUserId       String?                  @map("performed_by_user_id") @db.Uuid
  /// For REVERSAL rows: the row this one cancels. A row is reversed at most once.
  reversalOfTransactionId String?                  @map("reversal_of_transaction_id") @db.Uuid
  note                    String?
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch                @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  part         Part                  @relation(fields: [organizationId, partId], references: [organizationId, id], onDelete: Restrict)
  purchaseItem PurchaseItem?         @relation(fields: [organizationId, purchaseItemId], references: [organizationId, id], onDelete: Restrict)
  partUsage    PartUsage?            @relation(fields: [organizationId, partUsageId], references: [organizationId, id], onDelete: Restrict)
  invoice      Invoice?              @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Restrict)
  creditNote   CreditNote?           @relation(fields: [organizationId, creditNoteId], references: [organizationId, id], onDelete: Restrict)
  stockCount   StockCount?           @relation(fields: [organizationId, stockCountId], references: [organizationId, id], onDelete: Restrict)
  performedBy  User?                 @relation(fields: [organizationId, performedByUserId], references: [organizationId, id], onDelete: Restrict)
  reversalOf   InventoryTransaction? @relation("InventoryReversal", fields: [organizationId, reversalOfTransactionId], references: [organizationId, id], onDelete: Restrict)
  reversedBy   InventoryTransaction? @relation("InventoryReversal")

  @@unique([organizationId, id])
  @@unique([organizationId, reversalOfTransactionId])
  @@index([organizationId])
  @@index([organizationId, branchId, partId])
  @@index([organizationId, partUsageId])
  @@index([organizationId, purchaseItemId])
  @@index([organizationId, invoiceId])
  @@index([organizationId, creditNoteId])
  @@index([organizationId, stockCountId])
  @@index([organizationId, partId])
  @@index([createdAt])
  @@map("inventory_transactions")
}

/// A stock count: the shelves counted, part by part, and each difference
/// from the system posted as an ADJUSTMENT linked here — so the count is one
/// record, with who counted and when, rather than loose adjustments.
model StockCount {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  countNumber     String   @map("count_number")
  countedOn       DateTime @map("counted_on") @db.Date
  note            String?
  /// Parts counted (including those that matched the system).
  partsCounted    Int      @map("parts_counted")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch                 @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  createdBy    User                   @relation(fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  movements    InventoryTransaction[]

  @@unique([organizationId, id])
  @@unique([organizationId, countNumber])
  @@index([organizationId, countedOn])
  @@map("stock_counts")
}

// =============================================================================
// FINANCE
// =============================================================================

/// Only TAX_INVOICE and PROFORMA in V1. Quotation remains represented by
/// Estimate — do not conflate the two. DocumentNumberSequence issues
/// separate number series per type, so the human-readable numbers never
/// overlap even though both types share this table.
///
/// createdByUserId (who drafted it) is always required; issuedByUserId/
/// issuedAt are nullable and populated only when the invoice transitions
/// DRAFT -> ISSUED — requiring an "issuer" at DRAFT-creation time was
/// semantically wrong and has been corrected.
///
/// A PROFORMA must never carry a journalEntryId (it is not a revenue-
/// recognition event) — enforced via a raw SQL CHECK constraint added in
/// the migration (see migration.sql), since this Prisma version has no
/// native @@check attribute. Ordinary Payment against a PROFORMA is
/// forbidden by application logic (cross-table, not DB-enforceable).
model Invoice {
  id                   String        @id @default(uuid(7)) @db.Uuid
  organizationId       String        @map("organization_id") @db.Uuid
  branchId             String        @map("branch_id") @db.Uuid
  jobCardId            String?       @map("job_card_id") @db.Uuid
  customerId           String        @map("customer_id") @db.Uuid
  /// The vehicle the work was done on. Backfilled from the job card for
  /// every invoice that had one, and set directly on an invoice raised
  /// without one, so the tax invoice always names the car. Optional — not
  /// every invoice is about a vehicle.
  vehicleId            String?       @map("vehicle_id") @db.Uuid
  invoiceType          InvoiceType   @map("invoice_type")
  invoiceNumber        String        @map("invoice_number")
  status               InvoiceStatus @default(DRAFT)
  issueDate            DateTime      @map("issue_date") @db.Date
  supplyDate           DateTime?     @map("supply_date") @db.Date
  dueDate              DateTime?     @map("due_date") @db.Date
  /// Discount on the whole bill, taken after the lines' own discounts: a
  /// percentage or a fixed amount (type + value, as entered), and the AED
  /// it came to. `subtotal` is already net of it — the taxable amount —
  /// so total = subtotal + VAT holds with or without a discount.
  discountType         DiscountType? @map("discount_type")
  discountValue        Decimal?      @map("discount_value") @db.Decimal(14, 2)
  discountAmount       Decimal       @default(0) @map("discount_amount") @db.Decimal(14, 2)
  subtotal             Decimal       @db.Decimal(14, 2)
  taxAmount            Decimal       @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount          Decimal       @map("total_amount") @db.Decimal(14, 2)
  /// Taken back by tax credit notes (their totals, void ones excluded). What
  /// the customer owes is total − credited − paid − advance applied.
  creditedAmount       Decimal       @default(0) @map("credited_amount") @db.Decimal(14, 2)
  /// Settled from customer advances: the applications standing against it
  /// (undone ones excluded). Kept equal to them by a database check.
  advanceAppliedAmount Decimal       @default(0) @map("advance_applied_amount") @db.Decimal(14, 2)
  /// A round-off after VAT, plus or minus, at most 5.00 either way — outside
  /// VAT, booked to Rounding adjustments. total = subtotal + VAT + this.
  roundingAdjustment   Decimal       @default(0) @map("rounding_adjustment") @db.Decimal(14, 2)
  /// A discount given after the invoice, off its total ("3,654 — the customer
  /// paid 3,500"): the total and VAT stay as invoiced (only a tax credit note
  /// reduces VAT). What the customer owes is total − credited − this − paid −
  /// advance applied. Booked as its own entry: Dr Sales discounts, Cr
  /// receivables, on the day it was given.
  settlementDiscount   Decimal       @default(0) @map("settlement_discount") @db.Decimal(14, 2)
  settlementDiscountOn DateTime?     @map("settlement_discount_on") @db.Date
  notes                String?
  /// The customer's own purchase order (LPO) number, printed on the invoice.
  customerReference    String?       @map("customer_reference")
  /// Set when the invoice is voided (status VOID). The number is never reused.
  voidedAt             DateTime?     @map("voided_at") @db.Timestamptz
  voidReason           String?       @map("void_reason")
  // Historical snapshot fields — copied from Organization/Customer at
  // issuance time, and never re-derived afterward, so a legally-issued tax
  // invoice keeps showing exactly what was represented at the time even if
  // the live Organization/Customer records change later.
  sellerLegalName      String?       @map("seller_legal_name")
  sellerTaxNumber      String?       @map("seller_tax_number")
  sellerAddress        String?       @map("seller_address")
  customerName         String?       @map("customer_name")
  customerTaxNumber    String?       @map("customer_tax_number")
  customerAddress      String?       @map("customer_address")
  journalEntryId       String?       @map("journal_entry_id") @db.Uuid
  createdByUserId      String        @map("created_by_user_id") @db.Uuid
  issuedByUserId       String?       @map("issued_by_user_id") @db.Uuid
  issuedAt             DateTime?     @map("issued_at") @db.Timestamptz
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch        @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  jobCard      JobCard?      @relation(fields: [organizationId, jobCardId], references: [organizationId, id], onDelete: Restrict)
  customer     Customer      @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  vehicle      Vehicle?      @relation(fields: [organizationId, vehicleId], references: [organizationId, id], onDelete: Restrict)
  journalEntry JournalEntry? @relation(fields: [organizationId, journalEntryId], references: [organizationId, id], onDelete: Restrict)
  createdBy    User          @relation("InvoiceCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  issuedBy     User?         @relation("InvoiceIssuedBy", fields: [organizationId, issuedByUserId], references: [organizationId, id], onDelete: Restrict)

  items    InvoiceItem[]
  payments Payment[]

  creditNotes        CreditNote[]
  advanceAllocations CustomerAdvanceAllocation[]

  stockMovements InventoryTransaction[]
  expenses       Expense[]

  @@unique([organizationId, id])
  @@unique([organizationId, invoiceNumber])
  /// A job card has at most one live invoice; a VOID/CANCELLED one can be replaced.
  @@unique([jobCardId], map: "one_live_invoice_per_job_card", where: raw("status <> 'VOID' AND status <> 'CANCELLED'"))
  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, jobCardId])
  @@index([organizationId, customerId])
  @@index([organizationId, vehicleId])
  @@index([organizationId, status])
  @@map("invoices")
}

/// partUsageId/labourId provide audit traceability from a financial line
/// back to the exact actual-work record it was billed from.
model InvoiceItem {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  invoiceId      String            @map("invoice_id") @db.Uuid
  /// Parts or labour, as printed in the invoice's TYPE column. Set from the
  /// labour / part record for a repair-billed line, from the quotation line
  /// for a quotation-billed one, and chosen on screen for a typed one.
  /// Label only — no total, VAT or balance ever reads it.
  itemType       EstimateItemType? @map("item_type")
  description    String
  quantity       Decimal           @db.Decimal(12, 3)
  unitPrice      Decimal           @map("unit_price") @db.Decimal(14, 2)
  lineTotal      Decimal           @map("line_total") @db.Decimal(14, 2)
  taxRate        Decimal?          @map("tax_rate") @db.Decimal(5, 2)
  taxAmount      Decimal?          @map("tax_amount") @db.Decimal(14, 2)
  /// The tax code chosen (Accounting → Tax codes). Its rate and treatment
  /// are copied onto the record when saved, so changing the code later never
  /// alters an issued document.
  taxCodeId      String?           @map("tax_code_id") @db.Uuid
  /// How the line is treated for VAT; its rate follows from it.
  vatTreatment   VatTreatment      @default(STANDARD) @map("vat_treatment")
  /// The line's own discount: a percentage or a fixed amount (type +
  /// value, as entered), and the AED it came to. `lineTotal` is net of it.
  /// `taxAmount` is the VAT on this line after its share of the bill
  /// discount too.
  discountType   DiscountType?     @map("discount_type")
  discountValue  Decimal?          @map("discount_value") @db.Decimal(14, 2)
  discountAmount Decimal           @default(0) @map("discount_amount") @db.Decimal(14, 2)
  /// The income account this line books to. Null: the default for its type
  /// (parts sales, labour sales) — lib/accounting/postings.ts.
  accountId      String?           @map("account_id") @db.Uuid
  partUsageId    String?           @map("part_usage_id") @db.Uuid
  /// The catalogue part a PART line sells (invoices written directly or
  /// from a quotation). Its stock leaves on issue, as a SALE movement.
  partId         String?           @map("part_id") @db.Uuid
  /// What the part cost the workshop, decided on the invoice line: the cost
  /// of sales booked for it. Never printed.
  unitCost       Decimal?          @map("unit_cost") @db.Decimal(14, 2)
  labourId       String?           @map("labour_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice          @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Cascade)
  partUsage    PartUsage?       @relation(fields: [organizationId, partUsageId], references: [organizationId, id], onDelete: Restrict)
  labour       Labour?          @relation(fields: [organizationId, labourId], references: [organizationId, id], onDelete: Restrict)
  part         Part?            @relation(fields: [organizationId, partId], references: [organizationId, id], onDelete: Restrict)
  account      ChartOfAccount?  @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)
  taxCode      TaxCode?         @relation(fields: [organizationId, taxCodeId], references: [organizationId, id], onDelete: Restrict)
  credits      CreditNoteItem[]

  @@index([organizationId])
  @@index([organizationId, invoiceId])
  @@index([organizationId, partId])
  @@map("invoice_items")
}

/// Represents money ACTUALLY received (rule 17) — never a pending/expected
/// amount, and the amount is always positive (a reversal is a separate row,
/// not a negative adjustment — see reversalOfPaymentId below; this is a
/// deliberate departure from InventoryTransaction's signed-quantity ledger
/// pattern, which does not fit financial receipts as well).
///
/// The original row is NEVER edited. A reversal is a new Payment row with
/// the SAME (positive) amount, status = REVERSED, and reversalOfPaymentId
/// pointing back at the original. "Amount actually paid" for an invoice is
/// computed as: SUM(amount) WHERE status = 'COMPLETED' AND id NOT IN
/// (SELECT reversalOfPaymentId FROM Payment WHERE reversalOfPaymentId IS
/// NOT NULL) — i.e. a COMPLETED payment only counts if nothing has reversed
/// it. See docs for the full invoice-balance/customer-outstanding formulas.
model Payment {
  id                  String        @id @default(uuid(7)) @db.Uuid
  organizationId      String        @map("organization_id") @db.Uuid
  invoiceId           String        @map("invoice_id") @db.Uuid
  paymentNumber       String?       @map("payment_number")
  amount              Decimal       @db.Decimal(14, 2)
  method              PaymentMethod
  status              PaymentStatus @default(COMPLETED)
  referenceNumber     String?       @map("reference_number")
  /// The cash, bank or card account the money went into. Null: the default
  /// for its method.
  accountId           String?       @map("account_id") @db.Uuid
  notes               String?
  reversalOfPaymentId String?       @map("reversal_of_payment_id") @db.Uuid
  receivedAt          DateTime      @default(now()) @map("received_at") @db.Timestamptz
  receivedByUserId    String        @map("received_by_user_id") @db.Uuid
  journalEntryId      String?       @map("journal_entry_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice         @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Restrict)
  reversalOf   Payment?        @relation("PaymentReversal", fields: [organizationId, reversalOfPaymentId], references: [organizationId, id], onDelete: Restrict)
  reversals    Payment[]       @relation("PaymentReversal")
  account      ChartOfAccount? @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)
  receivedBy   User            @relation(fields: [organizationId, receivedByUserId], references: [organizationId, id], onDelete: Restrict)
  journalEntry JournalEntry?   @relation(fields: [organizationId, journalEntryId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, paymentNumber])
  @@unique([reversalOfPaymentId])
  @@index([organizationId])
  @@index([organizationId, invoiceId])
  @@index([receivedAt])
  @@map("payments")
}

/// Supplier-side mirror of Payment — money ACTUALLY paid out (accounts
/// payable settlement). Kept as a separate model rather than overloading
/// Payment with a direction flag, since Payment's field names/semantics
/// (receivedAt, receivedByUserId, rule-17 framing) are specifically about
/// the customer-receipt direction. Same reversal pattern as Payment.
model SupplierPayment {
  id                          String        @id @default(uuid(7)) @db.Uuid
  organizationId              String        @map("organization_id") @db.Uuid
  purchaseId                  String        @map("purchase_id") @db.Uuid
  supplierPaymentNumber       String?       @map("supplier_payment_number")
  amount                      Decimal       @db.Decimal(14, 2)
  method                      PaymentMethod
  status                      PaymentStatus @default(COMPLETED)
  referenceNumber             String?       @map("reference_number")
  /// The cash or bank account it was paid from. Null: the default for its method.
  accountId                   String?       @map("account_id") @db.Uuid
  reversalOfSupplierPaymentId String?       @map("reversal_of_supplier_payment_id") @db.Uuid
  paidAt                      DateTime      @default(now()) @map("paid_at") @db.Timestamptz
  paidByUserId                String        @map("paid_by_user_id") @db.Uuid
  journalEntryId              String?       @map("journal_entry_id") @db.Uuid
  createdAt                   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchase     Purchase          @relation(fields: [organizationId, purchaseId], references: [organizationId, id], onDelete: Restrict)
  reversalOf   SupplierPayment?  @relation("SupplierPaymentReversal", fields: [organizationId, reversalOfSupplierPaymentId], references: [organizationId, id], onDelete: Restrict)
  reversals    SupplierPayment[] @relation("SupplierPaymentReversal")
  account      ChartOfAccount?   @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)
  paidBy       User              @relation(fields: [organizationId, paidByUserId], references: [organizationId, id], onDelete: Restrict)
  journalEntry JournalEntry?     @relation(fields: [organizationId, journalEntryId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, supplierPaymentNumber])
  @@unique([reversalOfSupplierPaymentId])
  @@index([organizationId])
  @@index([organizationId, purchaseId])
  @@index([paidAt])
  @@map("supplier_payments")
}

model Expense {
  id                String         @id @default(uuid(7)) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  branchId          String         @map("branch_id") @db.Uuid
  chartOfAccountId  String?        @map("chart_of_account_id") @db.Uuid
  expenseNumber     String?        @map("expense_number")
  status            ExpenseStatus  @default(RECORDED)
  description       String
  amount            Decimal        @db.Decimal(14, 2)
  taxRate           Decimal?       @map("tax_rate") @db.Decimal(5, 2)
  taxAmount         Decimal?       @map("tax_amount") @db.Decimal(14, 2)
  /// The tax code chosen (Accounting → Tax codes). Its rate and treatment
  /// are copied onto the record when saved, so changing the code later never
  /// alters an issued document.
  taxCodeId         String?        @map("tax_code_id") @db.Uuid
  expenseDate       DateTime       @map("expense_date") @db.Date
  vendorName        String?        @map("vendor_name")
  /// The supplier's own bill / invoice number, to spot the same bill entered twice.
  billNumber        String?        @map("bill_number")
  /// The supplier's TRN as printed on their tax invoice — what entitles the
  /// workshop to reclaim the VAT on it.
  supplierTrn       String?        @map("supplier_trn")
  /// Not paid yet: when the supplier expects to be paid.
  dueDate           DateTime?      @map("due_date") @db.Date
  /// The transfer, cheque or card-slip number it was paid with.
  paymentReference  String?        @map("payment_reference")
  notes             String?
  // If set, the expense was settled immediately (Cr Cash/Bank in the
  // journal posting). If null, it's treated as an accrued/unpaid liability
  // (Cr Accounts Payable) — no further payable-tracking entity in V1.
  paymentMethod     PaymentMethod? @map("payment_method")
  /// The cash or bank account it was paid from, when paid. Null: the default
  /// for its method.
  paidFromAccountId String?        @map("paid_from_account_id") @db.Uuid
  /// Paid with an owner's or partner's own money: the business owes them it
  /// (Cr Due to owner). Never set together with paymentMethod.
  paidByUserId      String?        @map("paid_by_user_id") @db.Uuid
  /// A cost of one job — outside work, towing, materials bought for it —
  /// counted in that job's cost and profit. A job card, or an invoice
  /// billed without one.
  jobCardId         String?        @map("job_card_id") @db.Uuid
  invoiceId         String?        @map("invoice_id") @db.Uuid
  recordedByUserId  String         @map("recorded_by_user_id") @db.Uuid
  journalEntryId    String?        @map("journal_entry_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch          @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  chartOfAccount ChartOfAccount? @relation(fields: [organizationId, chartOfAccountId], references: [organizationId, id], onDelete: Restrict)
  paidFrom       ChartOfAccount? @relation("ExpensePaidFrom", fields: [organizationId, paidFromAccountId], references: [organizationId, id], onDelete: Restrict)
  recordedBy     User            @relation(fields: [organizationId, recordedByUserId], references: [organizationId, id], onDelete: Restrict)
  journalEntry   JournalEntry?   @relation(fields: [organizationId, journalEntryId], references: [organizationId, id], onDelete: Restrict)
  taxCode        TaxCode?        @relation(fields: [organizationId, taxCodeId], references: [organizationId, id], onDelete: Restrict)

  paidByUser User?    @relation("ExpensePaidPersonallyBy", fields: [organizationId, paidByUserId], references: [organizationId, id], onDelete: Restrict)
  jobCard    JobCard? @relation(fields: [organizationId, jobCardId], references: [organizationId, id], onDelete: Restrict)
  invoice    Invoice? @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Restrict)

  /// Paid on a payment voucher (outside work): the voucher handed over for it.
  paymentVoucher PaymentVoucher?

  @@unique([organizationId, id])
  @@unique([organizationId, expenseNumber])
  @@index([organizationId, jobCardId])
  @@index([organizationId, invoiceId])
  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([expenseDate])
  @@map("expenses")
}

model ChartOfAccount {
  id               String       @id @default(uuid(7)) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  accountCode      String       @map("account_code")
  accountName      String       @map("account_name")
  accountType      AccountType  @map("account_type")
  parentAccountId  String?      @map("parent_account_id") @db.Uuid
  isActive         Boolean      @default(true) @map("is_active")
  /// Set on the accounts automatic postings use; null on the workshop's own.
  role             AccountRole? @map("role")
  /// Money can be received into or paid from it: cash, bank and card accounts.
  isPaymentAccount Boolean      @default(false) @map("is_payment_account")
  /// Kept per customer or per supplier: every journal line on it names one,
  /// and it counts in that party's balance and statement. Trade receivables
  /// and trade payables are always kept this way (see lib/accounting/sub-ledger.ts).
  subLedger        PartyType?   @map("sub_ledger")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parentAccount ChartOfAccount?  @relation("ChartOfAccountHierarchy", fields: [organizationId, parentAccountId], references: [organizationId, id], onDelete: Restrict)
  childAccounts ChartOfAccount[] @relation("ChartOfAccountHierarchy")

  expenses          Expense[]
  expensesPaidFrom  Expense[]          @relation("ExpensePaidFrom")
  invoiceItems      InvoiceItem[]
  payments          Payment[]
  supplierPayments  SupplierPayment[]
  vatFilings        VatFiling[]
  journalEntryLines JournalEntryLine[]

  creditNoteItems        CreditNoteItem[]
  creditNoteRefunds      CreditNote[]            @relation("CreditNoteRefundAccount")
  bankReconciliations    BankReconciliation[]
  transfersOut           MoneyTransfer[]         @relation("MoneyTransferFrom")
  transfersIn            MoneyTransfer[]         @relation("MoneyTransferTo")
  ownerMoney             OwnerMoney[]
  cardCollectionsIn      PaymentVoucher[]        @relation("PaymentVoucherCardAccount")
  paymentVouchersPaid    PaymentVoucher[]        @relation("PaymentVoucherPaidFrom")
  advancesReceivedInto   CustomerAdvance[]       @relation("CustomerAdvanceAccount")
  advanceRefundsPaidFrom CustomerAdvanceRefund[] @relation("AdvanceRefundAccount")
  fixedAssets            FixedAsset[]            @relation("FixedAssetAccount")
  fixedAssetsAccumulated FixedAsset[]            @relation("FixedAssetAccumulated")
  fixedAssetsExpense     FixedAsset[]            @relation("FixedAssetExpense")
  fixedAssetsPaidFrom    FixedAsset[]            @relation("FixedAssetPaidFrom")
  fixedAssetsProceeds    FixedAsset[]            @relation("FixedAssetProceeds")
  paymentModes           PaymentMode[]

  ownerReimbursements OwnerReimbursement[] @relation("OwnerReimbursementPaidFrom")

  @@unique([organizationId, id])
  @@unique([organizationId, accountCode])
  @@unique([organizationId, role])
  @@index([organizationId])
  @@index([organizationId, parentAccountId])
  @@map("chart_of_accounts")
}

/// isPosted marks the entry immutable (rule 19) — a correction is a new
/// JournalEntry with reversalOfJournalEntryId pointing back at the original,
/// never an edit to a posted entry.
model JournalEntry {
  id                       String        @id @default(uuid(7)) @db.Uuid
  organizationId           String        @map("organization_id") @db.Uuid
  branchId                 String?       @map("branch_id") @db.Uuid
  /// JV-000001, in order of booking.
  entryNumber              String?       @map("entry_number")
  /// The record this entry books (an invoice, payment, …), or MANUAL for an
  /// entry made by hand. `sourceId` is that record's id.
  sourceType               JournalSource @default(MANUAL) @map("source_type")
  sourceId                 String?       @map("source_id") @db.Uuid
  entryDate                DateTime      @map("entry_date") @db.Date
  description              String?
  isPosted                 Boolean       @default(false) @map("is_posted")
  postedAt                 DateTime?     @map("posted_at") @db.Timestamptz
  postedByUserId           String?       @map("posted_by_user_id") @db.Uuid
  reversalOfJournalEntryId String?       @map("reversal_of_journal_entry_id") @db.Uuid
  createdByUserId          String        @map("created_by_user_id") @db.Uuid
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?        @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  reversalOf   JournalEntry?  @relation("JournalEntryReversal", fields: [organizationId, reversalOfJournalEntryId], references: [organizationId, id], onDelete: Restrict)
  reversals    JournalEntry[] @relation("JournalEntryReversal")
  createdBy    User           @relation("JournalEntryCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  postedBy     User?          @relation("JournalEntryPostedBy", fields: [organizationId, postedByUserId], references: [organizationId, id], onDelete: Restrict)

  lines            JournalEntryLine[]
  payments         Payment[]
  supplierPayments SupplierPayment[]
  expenses         Expense[]
  payrolls         Payroll[]
  purchases        Purchase[]
  invoices         Invoice[]

  ownerReimbursements OwnerReimbursement[]

  @@unique([organizationId, id])
  @@unique([organizationId, entryNumber])
  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, sourceType, sourceId])
  @@index([organizationId, entryDate])
  @@index([entryDate])
  @@map("journal_entries")
}

/// Debit/credit balance (sum of debits == sum of credits per entry) is a
/// double-entry-bookkeeping invariant enforced at the application layer —
/// Postgres CHECK constraints can't easily express a cross-row aggregate
/// invariant like this without a trigger, which is out of scope for V1.
model JournalEntryLine {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  journalEntryId   String   @map("journal_entry_id") @db.Uuid
  chartOfAccountId String   @map("chart_of_account_id") @db.Uuid
  debitAmount      Decimal  @default(0) @map("debit_amount") @db.Decimal(14, 2)
  creditAmount     Decimal  @default(0) @map("credit_amount") @db.Decimal(14, 2)
  description      String?
  /// The customer or supplier the line is for, on an account kept per party.
  customerId       String?  @map("customer_id") @db.Uuid
  supplierId       String?  @map("supplier_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  journalEntry   JournalEntry   @relation(fields: [organizationId, journalEntryId], references: [organizationId, id], onDelete: Cascade)
  chartOfAccount ChartOfAccount @relation(fields: [organizationId, chartOfAccountId], references: [organizationId, id], onDelete: Restrict)
  customer       Customer?      @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, map: "journal_entry_lines_customer_fkey")
  supplier       Supplier?      @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict, map: "journal_entry_lines_supplier_fkey")

  reconciled ReconciledLine?

  @@index([organizationId])
  @@index([organizationId, journalEntryId])
  @@index([organizationId, chartOfAccountId])
  @@index([organizationId, customerId])
  @@index([organizationId, supplierId])
  @@map("journal_entry_lines")
}

/// A VAT return filed with the FTA (a VAT201 on EmaraTax): the figures as
/// filed, the FTA's reference, and — once settled — the payment or refund.
/// Filing books the period's VAT into what is due to the FTA and usually
/// closes the books through the period's last day (lib/accounting/vat-filing.ts).
/// One month's totals from before these books began — read off the invoice
/// book, the supplier bills and the bank — so the first tax year's profit
/// and loss, and the VAT returns for those months, are complete. Booked as a
/// summary entry (lib/accounting/prior-periods.ts); never more than a month.
model PriorPeriodSummary {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  periodFrom       DateTime @map("period_from") @db.Date
  periodTo         DateTime @map("period_to") @db.Date
  /// Sales before VAT, and the VAT charged on them (0 before VAT registration).
  sales            Decimal  @default(0) @db.Decimal(14, 2)
  salesVat         Decimal  @default(0) @map("sales_vat") @db.Decimal(14, 2)
  /// Spare parts bought, before VAT.
  partsBought      Decimal  @default(0) @map("parts_bought") @db.Decimal(14, 2)
  /// Other costs with VAT (rent, utilities, tools…), before VAT.
  costsWithVat     Decimal  @default(0) @map("costs_with_vat") @db.Decimal(14, 2)
  /// The VAT paid on the parts and those costs, claimed back.
  purchasesVat     Decimal  @default(0) @map("purchases_vat") @db.Decimal(14, 2)
  /// Costs with no VAT (government fees, visas, bank charges…).
  costsWithoutVat  Decimal  @default(0) @map("costs_without_vat") @db.Decimal(14, 2)
  salaries         Decimal  @default(0) @db.Decimal(14, 2)
  note             String?
  recordedByUserId String   @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recordedBy   User         @relation("PriorPeriodRecordedBy", fields: [organizationId, recordedByUserId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, periodFrom])
  @@index([organizationId, periodTo])
  @@map("prior_period_summaries")
}

model VatFiling {
  id                  String    @id @default(uuid(7)) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  periodFrom          DateTime  @map("period_from") @db.Date
  periodTo            DateTime  @map("period_to") @db.Date
  /// Box 1 — standard-rated supplies and their VAT.
  standardSupplies    Decimal   @map("standard_supplies") @db.Decimal(14, 2)
  outputVat           Decimal   @map("output_vat") @db.Decimal(14, 2)
  /// Box 4 — zero-rated supplies.
  zeroRatedSupplies   Decimal   @default(0) @map("zero_rated_supplies") @db.Decimal(14, 2)
  /// Box 9 — standard-rated expenses and the VAT recoverable on them.
  standardExpenses    Decimal   @map("standard_expenses") @db.Decimal(14, 2)
  inputVat            Decimal   @map("input_vat") @db.Decimal(14, 2)
  /// Box 14 — payable when positive, refundable when negative.
  netVat              Decimal   @map("net_vat") @db.Decimal(14, 2)
  /// The FTA's reference for the submitted return.
  ftaReference        String?   @map("fta_reference")
  filedOn             DateTime  @map("filed_on") @db.Date
  filedByUserId       String    @map("filed_by_user_id") @db.Uuid
  /// When the VAT was paid (or the refund received), and from which account.
  settledOn           DateTime? @map("settled_on") @db.Date
  settledAccountId    String?   @map("settled_account_id") @db.Uuid
  settlementReference String?   @map("settlement_reference")
  /// A return for a period before these books began, filed with the FTA
  /// before the workshop used the app: kept so the calendar knows it was
  /// filed, never booked — its VAT is in the opening balances.
  outsideBooks        Boolean   @default(false) @map("outside_books")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  filedBy        User            @relation("VatFilingFiledBy", fields: [organizationId, filedByUserId], references: [organizationId, id], onDelete: Restrict)
  settledAccount ChartOfAccount? @relation(fields: [organizationId, settledAccountId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, periodFrom, periodTo])
  @@index([organizationId, periodTo])
  @@map("vat_filings")
}

/// A tax credit note: part or all of an invoice taken back — a refund, a
/// correction, a goodwill reduction. It keeps its own number (CN-), names the
/// invoice it corrects, and reduces that invoice's balance and the VAT due
/// in the period it is issued. Whatever the customer had already paid beyond
/// the new balance is refunded, and recorded here.
model CreditNote {
  id               String           @id @default(uuid(7)) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  branchId         String           @map("branch_id") @db.Uuid
  invoiceId        String           @map("invoice_id") @db.Uuid
  customerId       String           @map("customer_id") @db.Uuid
  creditNoteNumber String           @map("credit_note_number")
  status           CreditNoteStatus @default(ISSUED)
  issueDate        DateTime         @map("issue_date") @db.Date
  reason           String
  /// When a whole discounted invoice is credited: its bill discount, taken
  /// back with it. `subtotal` is net of it, as on the invoice.
  discountAmount   Decimal          @default(0) @map("discount_amount") @db.Decimal(14, 2)
  subtotal         Decimal          @db.Decimal(14, 2)
  taxAmount        Decimal          @map("tax_amount") @db.Decimal(14, 2)
  totalAmount      Decimal          @map("total_amount") @db.Decimal(14, 2)
  /// The invoice's round-off, taken back by the note that credits the last
  /// of its lines. total = subtotal + VAT + this.
  roundingAmount   Decimal          @default(0) @map("rounding_amount") @db.Decimal(14, 2)
  /// What is paid back to the customer: the credit beyond what they still owed.
  refundAmount     Decimal          @default(0) @map("refund_amount") @db.Decimal(14, 2)
  refundedOn       DateTime?        @map("refunded_on") @db.Date
  refundMethod     PaymentMethod?   @map("refund_method")
  refundAccountId  String?          @map("refund_account_id") @db.Uuid
  refundReference  String?          @map("refund_reference")
  voidedAt         DateTime?        @map("voided_at") @db.Timestamptz
  voidReason       String?          @map("void_reason")
  createdByUserId  String           @map("created_by_user_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch                      @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  invoice        Invoice                     @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Restrict)
  customer       Customer                    @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  refundAccount  ChartOfAccount?             @relation("CreditNoteRefundAccount", fields: [organizationId, refundAccountId], references: [organizationId, id], onDelete: Restrict)
  createdBy      User                        @relation("CreditNoteCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  items          CreditNoteItem[]
  stockMovements InventoryTransaction[]
  advanceReturns CustomerAdvanceAllocation[] @relation("AdvanceAllocationReturnedBy")

  @@unique([organizationId, id])
  @@unique([organizationId, creditNoteNumber])
  @@index([organizationId, invoiceId])
  @@index([organizationId, issueDate])
  @@map("credit_notes")
}

model CreditNoteItem {
  id               String            @id @default(uuid(7)) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  creditNoteId     String            @map("credit_note_id") @db.Uuid
  /// The invoice line it credits, so no line is credited beyond its value.
  invoiceItemId    String?           @map("invoice_item_id") @db.Uuid
  itemType         EstimateItemType? @map("item_type")
  description      String
  quantity         Decimal           @db.Decimal(12, 3)
  unitPrice        Decimal           @map("unit_price") @db.Decimal(14, 2)
  /// Before the bill discount, as on the invoice line; `discountAmount` is
  /// its share of the invoice's bill discount, taken back with it.
  lineTotal        Decimal           @map("line_total") @db.Decimal(14, 2)
  discountAmount   Decimal           @default(0) @map("discount_amount") @db.Decimal(14, 2)
  vatTreatment     VatTreatment      @default(STANDARD) @map("vat_treatment")
  taxRate          Decimal           @map("tax_rate") @db.Decimal(5, 2)
  taxAmount        Decimal           @map("tax_amount") @db.Decimal(14, 2)
  /// The income account the credit comes off; null for the default of its type.
  accountId        String?           @map("account_id") @db.Uuid
  /// The catalogue part the credited line sold (copied from the invoice line).
  partId           String?           @map("part_id") @db.Uuid
  /// How many of it came back into stock — null or 0 when the credit is only
  /// money (a price reduction), not goods returned.
  returnedQuantity Decimal?          @map("returned_quantity") @db.Decimal(12, 3)
  /// What one cost, as on the invoice line: taken off cost of sales.
  unitCost         Decimal?          @map("unit_cost") @db.Decimal(14, 2)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creditNote   CreditNote      @relation(fields: [organizationId, creditNoteId], references: [organizationId, id], onDelete: Cascade)
  invoiceItem  InvoiceItem?    @relation(fields: [invoiceItemId], references: [id], onDelete: Restrict)
  account      ChartOfAccount? @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)
  part         Part?           @relation(fields: [organizationId, partId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, creditNoteId])
  @@index([organizationId, invoiceItemId])
  @@map("credit_note_items")
}

/// Matching a bank account in the books to the bank's statement: the lines
/// the statement shows are ticked as cleared until the books' cleared
/// balance equals the statement's. Completed reconciliations are kept.
model BankReconciliation {
  id                String               @id @default(uuid(7)) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  accountId         String               @map("account_id") @db.Uuid
  statementDate     DateTime             @map("statement_date") @db.Date
  statementBalance  Decimal              @map("statement_balance") @db.Decimal(14, 2)
  status            ReconciliationStatus @default(IN_PROGRESS)
  completedAt       DateTime?            @map("completed_at") @db.Timestamptz
  completedByUserId String?              @map("completed_by_user_id") @db.Uuid
  createdByUserId   String               @map("created_by_user_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account      ChartOfAccount   @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)
  createdBy    User             @relation("ReconciliationCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  completedBy  User?            @relation("ReconciliationCompletedBy", fields: [organizationId, completedByUserId], references: [organizationId, id], onDelete: Restrict)
  lines        ReconciledLine[]

  @@unique([organizationId, id])
  @@index([organizationId, accountId, statementDate])
  @@map("bank_reconciliations")
}

/// A journal line ticked as cleared on a bank statement. A line clears once.
model ReconciledLine {
  id                 String   @id @default(uuid(7)) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  reconciliationId   String   @map("reconciliation_id") @db.Uuid
  journalEntryLineId String   @unique @map("journal_entry_line_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reconciliation BankReconciliation @relation(fields: [organizationId, reconciliationId], references: [organizationId, id], onDelete: Cascade)
  line           JournalEntryLine   @relation(fields: [journalEntryLineId], references: [id], onDelete: Restrict)

  @@index([organizationId, reconciliationId])
  @@map("reconciled_lines")
}

/// Equipment, vehicles, fittings the workshop owns and uses for years. Its
/// cost is spread over its useful life as monthly depreciation (straight
/// line, down to its residual value); a sale or scrapping takes it off the
/// books with any gain or loss.
model FixedAsset {
  id                   String           @id @default(uuid(7)) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  assetNumber          String           @map("asset_number")
  name                 String
  description          String?
  /// Where its cost sits, where its depreciation builds up, and where each
  /// month's depreciation is charged.
  assetAccountId       String           @map("asset_account_id") @db.Uuid
  accumulatedAccountId String           @map("accumulated_account_id") @db.Uuid
  expenseAccountId     String           @map("expense_account_id") @db.Uuid
  acquiredOn           DateTime         @map("acquired_on") @db.Date
  cost                 Decimal          @db.Decimal(14, 2)
  residualValue        Decimal          @default(0) @map("residual_value") @db.Decimal(14, 2)
  usefulLifeMonths     Int              @map("useful_life_months")
  funding              AssetFunding
  /// PAID: the cash or bank account it was paid from.
  paidFromAccountId    String?          @map("paid_from_account_id") @db.Uuid
  /// OPENING: depreciation already charged before the books began, and the
  /// day it was charged to — the day the asset comes into the books.
  openingDepreciation  Decimal          @default(0) @map("opening_depreciation") @db.Decimal(14, 2)
  openingThrough       DateTime?        @map("opening_through") @db.Date
  status               FixedAssetStatus @default(ACTIVE)
  disposedOn           DateTime?        @map("disposed_on") @db.Date
  disposalProceeds     Decimal?         @map("disposal_proceeds") @db.Decimal(14, 2)
  proceedsAccountId    String?          @map("proceeds_account_id") @db.Uuid
  createdByUserId      String           @map("created_by_user_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assetAccount    ChartOfAccount      @relation("FixedAssetAccount", fields: [organizationId, assetAccountId], references: [organizationId, id], onDelete: Restrict)
  accumulated     ChartOfAccount      @relation("FixedAssetAccumulated", fields: [organizationId, accumulatedAccountId], references: [organizationId, id], onDelete: Restrict)
  expenseAccount  ChartOfAccount      @relation("FixedAssetExpense", fields: [organizationId, expenseAccountId], references: [organizationId, id], onDelete: Restrict)
  paidFrom        ChartOfAccount?     @relation("FixedAssetPaidFrom", fields: [organizationId, paidFromAccountId], references: [organizationId, id], onDelete: Restrict)
  proceedsAccount ChartOfAccount?     @relation("FixedAssetProceeds", fields: [organizationId, proceedsAccountId], references: [organizationId, id], onDelete: Restrict)
  createdBy       User                @relation("FixedAssetCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  depreciations   AssetDepreciation[]

  @@unique([organizationId, id])
  @@unique([organizationId, assetNumber])
  @@index([organizationId, status])
  @@map("fixed_assets")
}

/// One month's depreciation of one asset, booked once.
model AssetDepreciation {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  fixedAssetId   String   @map("fixed_asset_id") @db.Uuid
  /// The last day of the month it covers.
  periodEnd      DateTime @map("period_end") @db.Date
  amount         Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fixedAsset   FixedAsset   @relation(fields: [organizationId, fixedAssetId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([fixedAssetId, periodEnd])
  @@index([organizationId, periodEnd])
  @@map("asset_depreciations")
}

// =============================================================================
// HR
// =============================================================================

model Employee {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  branchId        String    @map("branch_id") @db.Uuid
  /// Optional: not every employee (e.g. a floor technician) needs a system
  /// login. This is the link rule 6 relies on to keep JobAssignment pointed
  /// at Employee rather than User.
  userId          String?   @map("user_id") @db.Uuid
  employeeCode    String    @map("employee_code")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  /// Shown wherever the person is named; follows the designation's name
  /// when one is chosen.
  jobTitle        String?   @map("job_title")
  designationId   String?   @map("designation_id") @db.Uuid
  /// The employee's own contact details, independent of any system login:
  /// a technician who never signs in can still be reached.
  phone           String?
  email           String?
  department      String?
  /// How their salary is paid through WPS: their MOHRE person code (14
  /// digits), the routing code of their bank or exchange house (9 digits)
  /// and their account's IBAN. Seen only by those who see pay.
  wpsPersonCode   String?   @map("wps_person_code")
  wpsAgentCode    String?   @map("wps_agent_code")
  salaryIban      String?   @map("salary_iban")
  hireDate        DateTime  @map("hire_date") @db.Date
  terminationDate DateTime? @map("termination_date") @db.Date
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  user         User?        @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  designation  Designation? @relation(fields: [organizationId, designationId], references: [organizationId, id], onDelete: Restrict)

  jobAssignments JobAssignment[]
  inspections    Inspection[]
  diagnoses      Diagnosis[]
  labours        Labour[]
  partUsages     PartUsage[]
  workRecords    WorkRecord[]
  qualityChecks  QualityCheck[]
  attendances    Attendance[]
  leaves         Leave[]
  salaries       Salary[]
  payrollItems   PayrollItem[]
  tasks          Task[]

  @@unique([organizationId, id])
  @@unique([organizationId, employeeCode])
  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, designationId])
  @@map("employees")
}

model Attendance {
  id                String           @id @default(uuid(7)) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  branchId          String           @map("branch_id") @db.Uuid
  employeeId        String           @map("employee_id") @db.Uuid
  attendanceDate    DateTime         @map("attendance_date") @db.Date
  clockInAt         DateTime?        @map("clock_in_at") @db.Timestamptz
  clockOutAt        DateTime?        @map("clock_out_at") @db.Timestamptz
  status            AttendanceStatus
  notes             String?
  /// How each stamp was made, and — for a self check-in — where the phone
  /// was: its position, how precise it said it was, and how far that is from
  /// the workshop. Null on days recorded before the location lock.
  clockInMethod     ClockMethod?     @map("clock_in_method")
  clockInLatitude   Decimal?         @map("clock_in_latitude") @db.Decimal(9, 6)
  clockInLongitude  Decimal?         @map("clock_in_longitude") @db.Decimal(9, 6)
  clockInAccuracyM  Int?             @map("clock_in_accuracy_m")
  clockInDistanceM  Int?             @map("clock_in_distance_m")
  clockOutMethod    ClockMethod?     @map("clock_out_method")
  clockOutLatitude  Decimal?         @map("clock_out_latitude") @db.Decimal(9, 6)
  clockOutLongitude Decimal?         @map("clock_out_longitude") @db.Decimal(9, 6)
  clockOutAccuracyM Int?             @map("clock_out_accuracy_m")
  clockOutDistanceM Int?             @map("clock_out_distance_m")
  /// A day whose check-out was not made at the workshop — closed
  /// automatically at the shift end, or reported afterwards by the employee.
  /// Stays true until someone with attendance.edit confirms or corrects it.
  needsReview       Boolean          @default(false) @map("needs_review")
  reviewedAt        DateTime?        @map("reviewed_at") @db.Timestamptz
  reviewedByUserId  String?          @map("reviewed_by_user_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  employee     Employee     @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  reviewedBy   User?        @relation("AttendanceReviewedBy", fields: [organizationId, reviewedByUserId], references: [organizationId, id], onDelete: Restrict)

  @@unique([employeeId, attendanceDate])
  @@index([organizationId, needsReview])
  @@index([organizationId])
  @@index([organizationId, branchId, attendanceDate])
  @@map("attendances")
}

model Leave {
  id               String      @id @default(uuid(7)) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  employeeId       String      @map("employee_id") @db.Uuid
  leaveType        LeaveType   @map("leave_type")
  startDate        DateTime    @map("start_date") @db.Date
  endDate          DateTime    @map("end_date") @db.Date
  status           LeaveStatus @default(PENDING)
  reason           String?
  approvedByUserId String?     @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?   @map("approved_at") @db.Timestamptz
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  approvedBy   User?        @relation(fields: [organizationId, approvedByUserId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, employeeId])
  @@index([organizationId, employeeId, startDate, endDate])
  @@map("leaves")
}

/// Multiple rows per employee over time = salary history. The "current"
/// salary is the row with the latest effectiveFrom and a null effectiveTo.
model Salary {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  basicSalary    Decimal   @map("basic_salary") @db.Decimal(14, 2)
  allowances     Decimal   @default(0) @db.Decimal(14, 2)
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, employeeId, effectiveFrom])
  @@map("salaries")
}

/// DRAFT -> CALCULATED -> APPROVED -> PAID, with CANCELLED as the terminal
/// abandonment state at any pre-PAID stage. Each stage has its own nullable
/// attribution + timestamp pair — none of them are required at creation,
/// since none of those actions have happened yet for a DRAFT run.
model Payroll {
  id               String        @id @default(uuid(7)) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  periodStart      DateTime      @map("period_start") @db.Date
  periodEnd        DateTime      @map("period_end") @db.Date
  status           PayrollStatus @default(DRAFT)
  calculatedAt     DateTime?     @map("calculated_at") @db.Timestamptz
  approvedByUserId String?       @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?     @map("approved_at") @db.Timestamptz
  paidByUserId     String?       @map("paid_by_user_id") @db.Uuid
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz
  journalEntryId   String?       @map("journal_entry_id") @db.Uuid
  createdByUserId  String        @map("created_by_user_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry? @relation(fields: [organizationId, journalEntryId], references: [organizationId, id], onDelete: Restrict)
  createdBy    User          @relation("PayrollCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  approvedBy   User?         @relation("PayrollApprovedBy", fields: [organizationId, approvedByUserId], references: [organizationId, id], onDelete: Restrict)
  paidBy       User?         @relation("PayrollPaidBy", fields: [organizationId, paidByUserId], references: [organizationId, id], onDelete: Restrict)

  items PayrollItem[]

  @@unique([organizationId, id])
  @@unique([organizationId, periodStart, periodEnd])
  @@index([organizationId])
  @@map("payrolls")
}

/// basicSalary/allowances are snapshotted from Salary at processing time
/// (historical accuracy) — payroll must reflect what was actually paid even
/// if the employee's Salary record changes afterward.
model PayrollItem {
  id                String   @id @default(uuid(7)) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  payrollId         String   @map("payroll_id") @db.Uuid
  employeeId        String   @map("employee_id") @db.Uuid
  basicSalary       Decimal  @map("basic_salary") @db.Decimal(14, 2)
  allowances        Decimal  @default(0) @db.Decimal(14, 2)
  deductions        Decimal  @default(0) @db.Decimal(14, 2)
  netPay            Decimal  @map("net_pay") @db.Decimal(14, 2)
  /// End-of-service gratuity earned to the period end, and the increase over
  /// the last payroll (negative if the basic salary fell) — booked with the run.
  gratuityLiability Decimal  @default(0) @map("gratuity_liability") @db.Decimal(14, 2)
  gratuityAccrual   Decimal  @default(0) @map("gratuity_accrual") @db.Decimal(14, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payroll      Payroll      @relation(fields: [organizationId, payrollId], references: [organizationId, id], onDelete: Cascade)
  employee     Employee     @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)

  @@unique([payrollId, employeeId])
  @@index([organizationId])
  @@index([organizationId, employeeId])
  @@map("payroll_items")
}

// =============================================================================
// DOCUMENT / NUMBERING FOUNDATION
// =============================================================================

/// Configuration for concurrency-safe numbering, not the allocation
/// mechanism itself. The (not-yet-built) allocation service must, at
/// minimum: allocate inside a transaction with row-level locking (e.g.
/// `SELECT ... FOR UPDATE` on this row); increment nextNumber atomically in
/// that same transaction; never reuse a number once allocated, even if the
/// document referencing it is later voided/cancelled; respect
/// allowManualOverride before accepting a manually-specified number.
///
/// This table alone (no separate allocated-numbers ledger) is sufficient:
/// "no reuse" falls out of the monotonic counter by construction, and
/// "cancelled documents retain their number" is already true since
/// cancelling only changes a document's status, never its number field.
model DocumentNumberSequence {
  id                  String       @id @default(uuid(7)) @db.Uuid
  organizationId      String       @map("organization_id") @db.Uuid
  branchId            String?      @map("branch_id") @db.Uuid
  documentType        DocumentType @map("document_type")
  prefix              String       @default("")
  padding             Int          @default(6)
  nextNumber          Int          @default(1) @map("next_number")
  allowManualOverride Boolean      @default(false) @map("allow_manual_override")
  isActive            Boolean      @default(true) @map("is_active")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, branchId, documentType], map: "doc_number_seq_branch_scoped_unique")
  @@unique([organizationId, documentType], map: "doc_number_seq_orgwide_unique", where: raw("branch_id IS NULL"))
  @@index([organizationId])
  @@map("document_number_sequences")
}

/// Generic, cross-cutting security/compliance audit trail. entityType +
/// entityId is a polymorphic "soft" reference — NOT a real foreign key,
/// since the target table varies by entityType. organizationId is still
/// required and application-validated against the target entity's own
/// organizationId; this is a deliberate, accepted exception to the
/// composite-FK isolation pattern used everywhere else (there is no single
/// fixed parent table to reference). Reads are never audited — only
/// state-changing actions (see docs for the V1 action list).
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  beforeData     Json?    @map("before_data")
  afterData      Json?    @map("after_data")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  actorUser    User?        @relation(fields: [organizationId, actorUserId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actorUserId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

/// Document/attachment METADATA only — the binary itself lives in external
/// object storage (not built yet), storageKey is the pointer into it.
/// entityType/entityId is the same polymorphic soft-reference pattern as
/// AuditLog, with the same accepted integrity trade-off.
model Document {
  id               String           @id @default(uuid(7)) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  branchId         String?          @map("branch_id") @db.Uuid
  entityType       String           @map("entity_type")
  entityId         String           @map("entity_id") @db.Uuid
  documentType     DocumentCategory @map("document_type")
  fileName         String           @map("file_name")
  storageKey       String           @map("storage_key")
  mimeType         String           @map("mime_type")
  fileSize         Int              @map("file_size")
  uploadedByUserId String           @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz
  /// Job-card media: the job the file belongs to (enforced by FK within the
  /// organization), the stage it documents and an optional caption.
  jobCardId        String?          @map("job_card_id") @db.Uuid
  stage            MediaStage?
  description      String?
  /// Who removed the file (soft delete — the stored file is kept).
  deletedByUserId  String?          @map("deleted_by_user_id") @db.Uuid
  /// Task media (photos, voice notes): the task it belongs to, whether it was
  /// added with the task itself (entityType "Task") or with an update on it
  /// (entityType "TaskUpdate", entityId the update).
  taskId           String?          @map("task_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  uploadedBy   User         @relation("DocumentUploadedBy", fields: [organizationId, uploadedByUserId], references: [organizationId, id], onDelete: Restrict)
  jobCard      JobCard?     @relation(fields: [organizationId, jobCardId], references: [organizationId, id], onDelete: Restrict)
  deletedBy    User?        @relation("DocumentDeletedBy", fields: [organizationId, deletedByUserId], references: [organizationId, id], onDelete: Restrict)
  task         Task?        @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Restrict)
  signature    Signature?

  @@unique([organizationId, id])
  @@index([organizationId, jobCardId, stage])
  @@index([organizationId, taskId])
  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, uploadedByUserId])
  @@map("documents")
}

/// Scoped, expiring, revocable customer access (section 13-15 of the V1
/// build instruction): one token = one specific Estimate or Invoice, never a
/// general customer login/portal session. Only tokenHash is stored — the
/// raw token exists only in the link sent to the customer. The customer
/// must additionally identify themselves (vehicle plate + mobile, or an OTP
/// where connected — see docs/integrations.md) before the resource is
/// shown; the token alone is necessary but not sufficient.
model CustomerAccessToken {
  id              String                     @id @default(uuid(7)) @db.Uuid
  organizationId  String                     @map("organization_id") @db.Uuid
  resourceType    CustomerAccessResourceType @map("resource_type")
  resourceId      String                     @map("resource_id") @db.Uuid
  tokenHash       String                     @unique @map("token_hash")
  expiresAt       DateTime                   @map("expires_at") @db.Timestamptz
  revokedAt       DateTime?                  @map("revoked_at") @db.Timestamptz
  lastAccessedAt  DateTime?                  @map("last_accessed_at") @db.Timestamptz
  createdByUserId String                     @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation(fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, resourceType, resourceId])
  @@map("customer_access_tokens")
}

/// One-time keys that make form submissions safe to repeat. The browser sends
/// a fresh key with each submission; the server claims it in the same
/// transaction as the change. A repeated submission (double click, retry on a
/// slow network) finds the key already claimed and is answered with the
/// original result instead of creating a second payment, part usage, labour
/// entry, appointment or check-in. Rows are small and can be pruned after a
/// few days; nothing references them.
model RequestKey {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  requestKey     String   @map("request_key")
  action         String
  /// The record the first submission created, so a repeat can lead to it.
  resultId       String?  @map("result_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([organizationId, userId, requestKey])
  @@index([createdAt])
  @@map("request_keys")
}

/// An optional signature confirming a customer decision or a handover. The
/// image is stored like any other file (Document, category SIGNATURE); this
/// row records what was signed, by whom and when. Never required: a missing
/// row simply means no signature was given.
model Signature {
  id               String           @id @default(uuid(7)) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  jobCardId        String           @map("job_card_id") @db.Uuid
  context          SignatureContext
  /// The customer decision this signature confirms (quotation approval).
  approvalId       String?          @map("approval_id") @db.Uuid
  signerType       SignerType       @map("signer_type")
  signerName       String           @map("signer_name")
  customerId       String?          @map("customer_id") @db.Uuid
  /// Staff member whose device captured it (handover at the counter); NULL
  /// when the customer signed on their own phone through the secure link.
  capturedByUserId String?          @map("captured_by_user_id") @db.Uuid
  documentId       String           @map("document_id") @db.Uuid
  signedAt         DateTime         @default(now()) @map("signed_at") @db.Timestamptz
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobCard      JobCard      @relation(fields: [organizationId, jobCardId], references: [organizationId, id], onDelete: Restrict)
  approval     Approval?    @relation(fields: [organizationId, approvalId], references: [organizationId, id], onDelete: Restrict)
  customer     Customer?    @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  capturedBy   User?        @relation(fields: [organizationId, capturedByUserId], references: [organizationId, id], onDelete: Restrict)
  document     Document     @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, approvalId])
  @@unique([organizationId, documentId])
  /// One handover signature per job.
  @@unique([organizationId, jobCardId], map: "one_handover_signature_per_job", where: raw("context = 'DELIVERY_HANDOVER'"))
  @@index([organizationId, jobCardId])
  @@map("signatures")
}

/// Failed sign-in and customer-link attempts, for locking out guessing.
/// Keys are SHA-256 hashes (never an email, phone or IP in the clear).
/// Written only through the record_auth_failure() SQL function — see
/// migration 20260926090000_auth_throttles and lib/auth/throttle.ts.
model AuthThrottle {
  key             String    @id
  failures        Int       @default(0)
  windowStartedAt DateTime  @default(now()) @map("window_started_at") @db.Timestamptz
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@index([updatedAt])
  @@map("auth_throttles")
}

// =============================================================================
// ACCOUNTING MASTERS
// =============================================================================

/// A tax code — how a line is taxed, chosen on every sales and purchase line.
/// The four standard UAE codes (SR, ZR, EX, OS) are created for every
/// workshop; more can be added. The rate and treatment are copied onto each
/// line when it is saved (lib/accounting/tax-codes.ts).
model TaxCode {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  /// Short code printed on reports, e.g. SR, ZR, EX, OS.
  code           String
  name           String
  /// Percentage, e.g. 5.00. Always 0 unless the treatment is STANDARD.
  rate           Decimal      @db.Decimal(5, 2)
  /// Where it goes on the VAT return.
  treatment      VatTreatment
  /// Offered on sales documents (quotations, invoices).
  forSales       Boolean      @default(true) @map("for_sales")
  /// Offered on purchases and expenses.
  forPurchases   Boolean      @default(true) @map("for_purchases")
  /// The code new lines start with.
  isDefault      Boolean      @default(false) @map("is_default")
  /// One of the four standard codes: can be renamed, not deleted or re-treated.
  isSystem       Boolean      @default(false) @map("is_system")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  invoiceItems  InvoiceItem[]
  estimateItems EstimateItem[]
  purchaseItems PurchaseItem[]
  expenses      Expense[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@unique([organizationId], map: "tax_codes_one_default", where: raw("is_default"))
  @@index([organizationId])
  @@map("tax_codes")
}

/// A way money is received or paid — "Cash", "Card (Network)", "ADCB
/// current account", "Cheque" — each tied to the ledger account the money
/// goes into or comes out of. Choosing a mode on a receipt or payment
/// decides both its method and its account (lib/accounting/payment-modes.ts).
model PaymentMode {
  id                String        @id @default(uuid(7)) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  name              String
  /// The kind of payment it is — printed on receipts, used for the defaults.
  method            PaymentMethod
  /// The cash, bank or card account it posts to.
  accountId         String        @map("account_id") @db.Uuid
  /// Offered when taking money in (receipts).
  forReceipts       Boolean       @default(true) @map("for_receipts")
  /// Offered when paying money out (suppliers, expenses, refunds).
  forPayments       Boolean       @default(true) @map("for_payments")
  /// A cheque, card slip or transfer number must be given.
  requiresReference Boolean       @default(false) @map("requires_reference")
  isDefault         Boolean       @default(false) @map("is_default")
  isActive          Boolean       @default(true) @map("is_active")
  sortOrder         Int           @default(0) @map("sort_order")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account      ChartOfAccount @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@unique([organizationId], map: "payment_modes_one_default", where: raw("is_default"))
  @@index([organizationId])
  @@map("payment_modes")
}

/// Money paid back to an owner or partner for business costs they paid
/// personally: Dr Due to owner, Cr the cash or bank account. Reversed like a
/// supplier payment — the original is kept and marked REVERSED, and a linked
/// reversal row is written; both drop out of what is owed.
model OwnerReimbursement {
  id                String        @id @default(uuid(7)) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  personUserId      String        @map("person_user_id") @db.Uuid
  amount            Decimal       @db.Decimal(14, 2)
  method            PaymentMethod
  status            PaymentStatus @default(COMPLETED)
  paidFromAccountId String?       @map("paid_from_account_id") @db.Uuid
  /// The transfer or cheque reference.
  reference         String?
  note              String?
  reversalOfId      String?       @map("reversal_of_id") @db.Uuid
  paidOn            DateTime      @map("paid_on") @db.Date
  recordedByUserId  String        @map("recorded_by_user_id") @db.Uuid
  journalEntryId    String?       @map("journal_entry_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  person       User                 @relation("OwnerReimbursementPerson", fields: [organizationId, personUserId], references: [organizationId, id], onDelete: Restrict)
  recordedBy   User                 @relation("OwnerReimbursementRecordedBy", fields: [organizationId, recordedByUserId], references: [organizationId, id], onDelete: Restrict)
  paidFrom     ChartOfAccount?      @relation("OwnerReimbursementPaidFrom", fields: [organizationId, paidFromAccountId], references: [organizationId, id], onDelete: Restrict)
  reversalOf   OwnerReimbursement?  @relation("OwnerReimbursementReversal", fields: [organizationId, reversalOfId], references: [organizationId, id], onDelete: Restrict)
  reversals    OwnerReimbursement[] @relation("OwnerReimbursementReversal")
  journalEntry JournalEntry?        @relation(fields: [organizationId, journalEntryId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([reversalOfId])
  @@index([organizationId, personUserId])
  @@map("owner_reimbursements")
}

/// What an owner did with money: put it in to stay (capital), lent it
/// (taken back later through "Reimburse owner"), or took it out (drawings).
/// A partner (owner) of the business — a name the accountant keeps, not a
/// login. Their money put in, lent and taken out is recorded against them.
model Partner {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ownerMoney   OwnerMoney[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("partners")
}

enum OwnerMoneyKind {
  CAPITAL_IN
  LOAN_IN
  DRAWINGS
}

enum OwnerMoneyStatus {
  POSTED
  /// Withdrawn — entered in error. Kept on record; its entry is reversed.
  VOID
}

/// An owner putting money into the business or taking it out (OWN-): into or
/// out of one of its cash, petty cash or bank accounts. Booked as journal
/// source OWNER_MONEY:
///   capital in    Dr the money account / Cr Owner's capital
///   loan in       Dr the money account / Cr Due to owner
///   drawings      Dr Owner's drawings / Cr the money account
/// Never edited: a mistake is voided, which reverses its entry.
model OwnerMoney {
  id              String           @id @default(uuid(7)) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  entryNumber     String           @map("entry_number")
  kind            OwnerMoneyKind
  /// The cash, petty cash or bank account the money went into or came out of.
  accountId       String           @map("account_id") @db.Uuid
  /// The owner it came from or went to (an active holder of the Owner role).
  ownerUserId     String?          @map("owner_user_id") @db.Uuid
  /// The partner whose money it is (Money → Owner's money → Partners).
  partnerId       String?          @map("partner_id") @db.Uuid
  amount          Decimal          @db.Decimal(14, 2)
  movedOn         DateTime         @map("moved_on") @db.Date
  reference       String?
  notes           String?
  status          OwnerMoneyStatus @default(POSTED)
  voidedAt        DateTime?        @map("voided_at") @db.Timestamptz
  voidReason      String?          @map("void_reason")
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account      ChartOfAccount @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)
  owner        User?          @relation("OwnerMoneyOwner", fields: [organizationId, ownerUserId], references: [organizationId, id], onDelete: Restrict)
  partner      Partner?       @relation(fields: [organizationId, partnerId], references: [organizationId, id], onDelete: Restrict)
  createdBy    User           @relation("OwnerMoneyCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, entryNumber])
  @@index([organizationId, movedOn])
  @@map("owner_money")
}

enum MoneyTransferStatus {
  POSTED
  /// Withdrawn — entered in error. Kept on record; its entry is reversed.
  VOID
}

/// Money moved between the workshop's own cash, bank and card accounts —
/// cash on hand into the petty-cash box, the day's takings into the bank.
/// Neither income nor expense: the books show Dr the account it went to,
/// Cr the account it came from (source MONEY_TRANSFER). Numbered TRF-.
/// Never edited: a mistake is voided, which reverses its entry.
///
/// What the bank kept on the way — the card machine's fee when card money
/// is paid into the bank — is a bank charge, with the bank's VAT on it:
///   Dr the account it went to       amount (what arrived)
///   Dr Bank charges                 chargesAmount
///   Dr Input VAT recoverable        chargesVatAmount
///   Cr the account it came from     the three together
model MoneyTransfer {
  id               String              @id @default(uuid(7)) @db.Uuid
  organizationId   String              @map("organization_id") @db.Uuid
  transferNumber   String              @map("transfer_number")
  fromAccountId    String              @map("from_account_id") @db.Uuid
  toAccountId      String              @map("to_account_id") @db.Uuid
  /// What arrived in the account it went to.
  amount           Decimal             @db.Decimal(14, 2)
  /// What the bank kept as its fee, before VAT. 0: nothing kept.
  chargesAmount    Decimal             @default(0) @map("charges_amount") @db.Decimal(14, 2)
  /// The bank's VAT on that fee (on its tax invoice or statement).
  chargesVatAmount Decimal             @default(0) @map("charges_vat_amount") @db.Decimal(14, 2)
  transferredOn    DateTime            @map("transferred_on") @db.Date
  /// A deposit slip, transfer or cheque number.
  reference        String?
  notes            String?
  status           MoneyTransferStatus @default(POSTED)
  voidedAt         DateTime?           @map("voided_at") @db.Timestamptz
  voidReason       String?             @map("void_reason")
  createdByUserId  String              @map("created_by_user_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fromAccount  ChartOfAccount @relation("MoneyTransferFrom", fields: [organizationId, fromAccountId], references: [organizationId, id], onDelete: Restrict)
  toAccount    ChartOfAccount @relation("MoneyTransferTo", fields: [organizationId, toAccountId], references: [organizationId, id], onDelete: Restrict)
  createdBy    User           @relation("MoneyTransferCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, transferNumber])
  @@index([organizationId, transferredOn])
  @@map("money_transfers")
}

enum PaymentVoucherKind {
  /// Someone else's customer paid on the workshop's card machine (an outside
  /// upholsterer without one). The money is theirs: owed to them, and paid
  /// over less what the bank kept for it.
  CARD_COLLECTION
  /// Outside work or a service paid for — an outside mechanic called in, a
  /// sublet repair. Recorded as an expense (expenseId), so it counts in the
  /// job's cost when it was for one.
  WORK
}

enum PaymentVoucherStatus {
  /// Card money collected for them, not paid over yet.
  OWED
  PAID
  /// Withdrawn — entered in error. Kept on record; its entries are reversed.
  VOID
}

/// A payment voucher (PV-): money paid out to someone, on paper they sign
/// for it. Never edited: a mistake is voided, which reverses its entries.
///
/// CARD_COLLECTION — two entries:
///   collected (CARD_COLLECTION, on collectedOn)
///     Dr the card account (Card settlements receivable)   collectedAmount
///     Cr Money collected for others                       collectedAmount
///   paid over (PAYMENT_VOUCHER, on paidOn)
///     Dr Money collected for others                       collectedAmount
///     Cr the account paid from                            amount
///     Cr Bank charges                                     feeAmount
///     Cr Input VAT recoverable                            feeVatAmount
///   The bank's fee on their money was theirs: recovered from them, it
///   comes off Bank charges, and its VAT off what the workshop reclaims.
///
/// WORK — the expense (expenseId) books it (source EXPENSE).
model PaymentVoucher {
  id                String               @id @default(uuid(7)) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  branchId          String               @map("branch_id") @db.Uuid
  voucherNumber     String               @map("voucher_number")
  kind              PaymentVoucherKind
  status            PaymentVoucherStatus @default(PAID)
  /// Who is paid: the person or business that signs for the money.
  payeeName         String               @map("payee_name")
  payeePhone        String?              @map("payee_phone")
  /// What it is for, as printed on the voucher.
  description       String
  /// CARD_COLLECTION: the day the card was swiped, how much, into which card account, and the slip.
  collectedOn       DateTime?            @map("collected_on") @db.Date
  collectedAmount   Decimal?             @map("collected_amount") @db.Decimal(14, 2)
  cardAccountId     String?              @map("card_account_id") @db.Uuid
  cardReference     String?              @map("card_reference")
  /// The bank's fee: its rate (e.g. 2.00 %), the fee, and the VAT on the fee.
  feeRate           Decimal?             @map("fee_rate") @db.Decimal(5, 2)
  feeAmount         Decimal              @default(0) @map("fee_amount") @db.Decimal(14, 2)
  feeVatAmount      Decimal              @default(0) @map("fee_vat_amount") @db.Decimal(14, 2)
  /// What was handed over. Null while OWED.
  amount            Decimal?             @db.Decimal(14, 2)
  paidOn            DateTime?            @map("paid_on") @db.Date
  paymentMethod     PaymentMethod?       @map("payment_method")
  paidFromAccountId String?              @map("paid_from_account_id") @db.Uuid
  paymentReference  String?              @map("payment_reference")
  /// WORK: the expense that books it.
  expenseId         String?              @map("expense_id") @db.Uuid
  notes             String?
  voidedAt          DateTime?            @map("voided_at") @db.Timestamptz
  voidReason        String?              @map("void_reason")
  createdByUserId   String               @map("created_by_user_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch          @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  cardAccount  ChartOfAccount? @relation("PaymentVoucherCardAccount", fields: [organizationId, cardAccountId], references: [organizationId, id], onDelete: Restrict)
  paidFrom     ChartOfAccount? @relation("PaymentVoucherPaidFrom", fields: [organizationId, paidFromAccountId], references: [organizationId, id], onDelete: Restrict)
  expense      Expense?        @relation(fields: [organizationId, expenseId], references: [organizationId, id], onDelete: Restrict)
  createdBy    User            @relation("PaymentVoucherCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, voucherNumber])
  @@unique([organizationId, expenseId])
  @@index([organizationId, status])
  @@index([organizationId, paidOn])
  @@map("payment_vouchers")
}

enum CustomerAdvanceStatus {
  /// Nothing applied or refunded yet.
  OPEN
  /// Part of it applied (or refunded); some still held for the customer.
  PARTIALLY_APPLIED
  /// All of it applied to invoices.
  FULLY_APPLIED
  /// Nothing left: the rest was paid back to the customer.
  REFUNDED
  /// Withdrawn — entered in error, before any of it was used. Kept on
  /// record; its entry is reversed.
  CANCELLED
}

/// How VAT is treated on money received in advance. Until the workshop's
/// accountant confirms the treatment, no VAT is booked on an advance: VAT is
/// charged on the invoice, exactly as for any other sale. The columns exist
/// so a confirmed treatment can be switched on without redesigning advances.
enum CustomerAdvanceVatTreatment {
  /// The default, and the only one in use: no VAT on the advance itself.
  PENDING_ACCOUNTANT_CONFIRMATION
  /// Confirmed: VAT is due only on the invoice (nothing on the advance).
  VAT_ON_INVOICE
  /// Confirmed: VAT is due when the advance is received (not yet enabled).
  VAT_ON_RECEIPT
}

/// Money a customer paid before their invoice — "AED 2,000 towards the
/// Patrol's repair". Owed to the customer (Customer advances, a liability)
/// until it is applied to their invoices or paid back. Numbered ADV-.
///
///   received   Dr the cash, bank or card account / Cr Customer advances
///   applied    Dr Customer advances / Cr Trade receivables (per allocation)
///   refunded   Dr Customer advances / Cr the account paid from (per refund)
///
/// What is left = amount − allocations standing − refunds standing; it is
/// worked out, never stored, and a database check keeps it from going below
/// zero. An advance is never edited: a mistake is cancelled (only while none
/// of it is used), which reverses its entry.
model CustomerAdvance {
  id                String                      @id @default(uuid(7)) @db.Uuid
  organizationId    String                      @map("organization_id") @db.Uuid
  branchId          String                      @map("branch_id") @db.Uuid
  customerId        String                      @map("customer_id") @db.Uuid
  /// The vehicle and job it is towards, when known.
  vehicleId         String?                     @map("vehicle_id") @db.Uuid
  jobCardId         String?                     @map("job_card_id") @db.Uuid
  advanceNumber     String                      @map("advance_number")
  amount            Decimal                     @db.Decimal(14, 2)
  receivedOn        DateTime                    @map("received_on") @db.Date
  method            PaymentMethod
  /// The cash, bank or card account it went into. Null: the method's default.
  accountId         String?                     @map("account_id") @db.Uuid
  /// A receipt, transfer or cheque number.
  reference         String?
  /// What it is for — "Advance for repair".
  notes             String?
  status            CustomerAdvanceStatus       @default(OPEN)
  vatTreatment      CustomerAdvanceVatTreatment @default(PENDING_ACCOUNTANT_CONFIRMATION) @map("vat_treatment")
  /// For when a VAT treatment on receipt is confirmed; unused (null and 0)
  /// while the treatment is pending.
  vatRate           Decimal?                    @map("vat_rate") @db.Decimal(5, 2)
  vatAmount         Decimal                     @default(0) @map("vat_amount") @db.Decimal(14, 2)
  cancelledAt       DateTime?                   @map("cancelled_at") @db.Timestamptz
  cancelReason      String?                     @map("cancel_reason")
  cancelledByUserId String?                     @map("cancelled_by_user_id") @db.Uuid
  receivedByUserId  String                      @map("received_by_user_id") @db.Uuid
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                    @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch          @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  customer     Customer        @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  vehicle      Vehicle?        @relation(fields: [organizationId, vehicleId], references: [organizationId, id], onDelete: Restrict)
  jobCard      JobCard?        @relation(fields: [organizationId, jobCardId], references: [organizationId, id], onDelete: Restrict)
  account      ChartOfAccount? @relation("CustomerAdvanceAccount", fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)
  receivedBy   User            @relation("CustomerAdvanceReceivedBy", fields: [organizationId, receivedByUserId], references: [organizationId, id], onDelete: Restrict)
  cancelledBy  User?           @relation("CustomerAdvanceCancelledBy", fields: [organizationId, cancelledByUserId], references: [organizationId, id], onDelete: Restrict)

  allocations CustomerAdvanceAllocation[]
  refunds     CustomerAdvanceRefund[]

  @@unique([organizationId, id])
  @@unique([organizationId, advanceNumber])
  @@index([organizationId, customerId])
  @@index([organizationId, jobCardId])
  @@index([organizationId, receivedOn])
  @@map("customer_advances")
}

/// Part of a customer advance applied to one invoice (source
/// CUSTOMER_ADVANCE_ALLOCATION): Dr Customer advances / Cr Trade receivables.
/// It counts towards the invoice like a payment, without being one — the
/// invoice's revenue, taxable amount and VAT are unchanged.
///
/// A row with a negative amount is money RETURNED to the advance by a credit
/// note that left the invoice over-settled (`creditNoteId`), dated on the
/// credit note: Dr Trade receivables / Cr Customer advances. The customer
/// keeps it as advance rather than being paid out in cash.
///
/// Undone, never deleted: `reversedAt` set, its entry reversed. An
/// application is undone by staff; a return, only by voiding its credit note.
model CustomerAdvanceAllocation {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  advanceId        String    @map("advance_id") @db.Uuid
  invoiceId        String    @map("invoice_id") @db.Uuid
  /// Above zero: applied to the invoice. Below zero: returned to the advance.
  amount           Decimal   @db.Decimal(14, 2)
  allocatedOn      DateTime  @map("allocated_on") @db.Date
  /// On a return: the credit note that returned it.
  creditNoteId     String?   @map("credit_note_id") @db.Uuid
  reversedAt       DateTime? @map("reversed_at") @db.Timestamptz
  reversalReason   String?   @map("reversal_reason")
  reversedByUserId String?   @map("reversed_by_user_id") @db.Uuid
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  advance      CustomerAdvance @relation(fields: [organizationId, advanceId], references: [organizationId, id], onDelete: Restrict)
  invoice      Invoice         @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Restrict)
  creditNote   CreditNote?     @relation("AdvanceAllocationReturnedBy", fields: [organizationId, creditNoteId], references: [organizationId, id], onDelete: Restrict)
  reversedBy   User?           @relation("AdvanceAllocationReversedBy", fields: [organizationId, reversedByUserId], references: [organizationId, id], onDelete: Restrict)
  createdBy    User            @relation("AdvanceAllocationCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, advanceId])
  @@index([organizationId, invoiceId])
  @@index([organizationId, creditNoteId])
  @@map("customer_advance_allocations")
}

/// Part of a customer advance paid back to the customer (source
/// CUSTOMER_ADVANCE_REFUND): Dr Customer advances / Cr the account paid
/// from. Reversed, never deleted: `reversedAt` set, its entry reversed.
model CustomerAdvanceRefund {
  id               String        @id @default(uuid(7)) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  advanceId        String        @map("advance_id") @db.Uuid
  amount           Decimal       @db.Decimal(14, 2)
  refundedOn       DateTime      @map("refunded_on") @db.Date
  method           PaymentMethod
  /// The cash or bank account it was paid from. Null: the method's default.
  accountId        String?       @map("account_id") @db.Uuid
  reference        String?
  notes            String?
  reversedAt       DateTime?     @map("reversed_at") @db.Timestamptz
  reversalReason   String?       @map("reversal_reason")
  reversedByUserId String?       @map("reversed_by_user_id") @db.Uuid
  createdByUserId  String        @map("created_by_user_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  advance      CustomerAdvance @relation(fields: [organizationId, advanceId], references: [organizationId, id], onDelete: Restrict)
  account      ChartOfAccount? @relation("AdvanceRefundAccount", fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)
  reversedBy   User?           @relation("AdvanceRefundReversedBy", fields: [organizationId, reversedByUserId], references: [organizationId, id], onDelete: Restrict)
  createdBy    User            @relation("AdvanceRefundCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, advanceId])
  @@map("customer_advance_refunds")
}

// =============================================================================
// TEAM — attendance methods and tasks
// =============================================================================

/// How an attendance stamp was made.
enum ClockMethod {
  /// The employee, on their own phone, inside the workshop's location lock.
  SELF
  /// Someone with attendance rights, for them.
  STAFF
  /// Closed by the system at the shift end: the day was left open.
  AUTO
  /// The employee said afterwards when they left (away from the workshop).
  REPORTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskUpdateKind {
  /// A note, a photo or a voice note added to the task.
  NOTE
  /// The task moved between statuses (body: the optional comment).
  STATUS
  /// Its details, due date, priority or assignee were changed.
  CHANGED
  /// Moved to another day (body: the reason, which is required).
  MOVED
}

/// One piece of work for one employee — given to them by someone with
/// task.create (`isAssigned`), or their own to-do. An assigned task's
/// title, due date, priority and assignee can only be changed by someone
/// with task.edit: the employee works it, comments on it and closes it.
///
/// The text is kept exactly as written or as the employee confirmed it from
/// speech, in the language it was spoken (`language`, a BCP-47 tag such as
/// "ml-IN"); nothing is translated behind anyone's back.
model Task {
  id                 String       @id @default(uuid(7)) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  branchId           String       @map("branch_id") @db.Uuid
  assigneeEmployeeId String       @map("assignee_employee_id") @db.Uuid
  title              String
  details            String?
  language           String?
  isAssigned         Boolean      @default(false) @map("is_assigned")
  priority           TaskPriority @default(NORMAL)
  dueDate            DateTime?    @map("due_date") @db.Date
  /// The day it was first due, kept when it is moved, and how often it was.
  originalDueDate    DateTime?    @map("original_due_date") @db.Date
  timesMoved         Int          @default(0) @map("times_moved")
  /// Starred by the assignee so it stands out on their list — their own
  /// marker, separate from the priority whoever gave the task chose.
  highlighted        Boolean      @default(false)
  jobCardId          String?      @map("job_card_id") @db.Uuid
  status             TaskStatus   @default(TODO)
  startedAt          DateTime?    @map("started_at") @db.Timestamptz
  completedAt        DateTime?    @map("completed_at") @db.Timestamptz
  completedByUserId  String?      @map("completed_by_user_id") @db.Uuid
  cancelledAt        DateTime?    @map("cancelled_at") @db.Timestamptz
  createdByUserId    String       @map("created_by_user_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  assignee     Employee     @relation(fields: [organizationId, assigneeEmployeeId], references: [organizationId, id], onDelete: Restrict)
  jobCard      JobCard?     @relation(fields: [organizationId, jobCardId], references: [organizationId, id], onDelete: Restrict)
  createdBy    User         @relation("TaskCreatedBy", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  completedBy  User?        @relation("TaskCompletedBy", fields: [organizationId, completedByUserId], references: [organizationId, id], onDelete: Restrict)

  updates   TaskUpdate[]
  documents Document[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, assigneeEmployeeId, status])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, jobCardId])
  @@map("tasks")
}

/// The task's history and conversation, oldest first. Append-only: an
/// update is never edited, so what was said and when stays as it was.
model TaskUpdate {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  taskId         String         @map("task_id") @db.Uuid
  authorUserId   String         @map("author_user_id") @db.Uuid
  kind           TaskUpdateKind @default(NOTE)
  body           String?
  language       String?
  fromStatus     TaskStatus?    @map("from_status")
  toStatus       TaskStatus?    @map("to_status")
  /// For CHANGED: what changed, as { field: [before, after] }.
  changes        Json?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  task         Task         @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Restrict)
  author       User         @relation(fields: [organizationId, authorUserId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, taskId, createdAt])
  @@map("task_updates")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

enum NotificationKind {
  /// A manager gave the person a task (or moved one to them).
  TASK_ASSIGNED
  /// The working day has started and they haven't checked in.
  CHECK_IN_REMINDER
  /// The working day has ended and they are still checked in.
  CHECK_OUT_REMINDER
  /// A VAT return, corporate tax, licence or monthly-routine deadline is
  /// coming or has passed (lib/compliance/reminders.ts).
  COMPLIANCE_REMINDER
}

/// Something for one person to see: in the bell in the top bar, and pushed
/// to their phone. Kept until they remove it; reading it only marks it read.
model Notification {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  kind           NotificationKind
  title          String
  body           String?
  /// Where tapping it leads, inside the app.
  href           String?
  /// Makes a reminder once-only ("checkin:2026-10-05"): the same key is
  /// never sent to the same person twice.
  dedupeKey      String?          @map("dedupe_key")
  readAt         DateTime?        @map("read_at") @db.Timestamptz
  /// Removed from the list by the person. The row is kept.
  dismissedAt    DateTime?        @map("dismissed_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([organizationId, userId, dismissedAt, createdAt])
  @@map("notifications")
}

/// A phone or browser that agreed to receive push notifications for a
/// login (the Web Push subscription it handed over).
model PushSubscription {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  endpoint       String    @unique
  p256dh         String
  auth           String
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSuccessAt  DateTime? @map("last_success_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@map("push_subscriptions")
}

/// The supplier's tax invoice for a purchase.
enum PurchaseBillStatus {
  /// Parts received (often bought for cash); the tax invoice is still to come.
  PENDING
  /// The tax invoice is in hand and matched to what was recorded.
  RECEIVED
  /// The supplier gives no tax invoice (not VAT-registered): no VAT claimed.
  NO_TAX_INVOICE
}
