# Dependencies
node_modules/

# Environment files (never commit real secrets)
.env
.env.*
!.env.example

# Build output
dist/
build/
.next/
out/

# Prisma generated client (build artifact, regenerated via `npm run prisma:generate`)
src/generated/

# Local file storage, only when STORAGE_DRIVER=local (photos, signatures).
# Hosted storage is Cloudinary; these files never belong in the repository.
.local-storage/

# Left over from the retired local PostgreSQL setup, in case a copy remains.
.local-postgres-data/

# Logs
npm-debug.log*
*.log

# Editor/OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Testing/coverage
coverage/

# TypeScript build info
*.tsbuildinfo

# Generated by Next.js on every dev/build; its docs say not to commit it.
next-env.d.ts

# Claude Code's per-machine settings and session files
.claude/settings.local.json
.claude/worktrees/

# Vercel
.vercel

# Throwaway scratch files from local diagnostics and browser walks. These
# hold test-organization logins and ids — never part of the codebase.
/.check.ts
/resp*.json
/.responsive*.json
